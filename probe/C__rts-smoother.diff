+#[test]
+fn empty_measurement_sequence_is_empty() {
+    let smoothed: Smoothed<f64> = rts_smooth(&random_walk(), &[]).unwrap();
+    assert_eq!(smoothed.len(), 0);
+    assert!(smoothed.is_empty());
+    assert!(smoothed.state(0).is_none());
+    assert!(smoothed.covariance(0).is_none());
+    assert!(smoothed.states().is_empty());
+    assert!(smoothed.covariances().is_empty());
+}
