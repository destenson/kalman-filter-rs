+#[test]
+fn out_of_range_steps_return_none() {
+    let smoothed = rts_smooth(&random_walk(), &measurements(4)).unwrap();
+    assert!(smoothed.state(4).is_none());
+    assert!(smoothed.covariance(99).is_none());
+}
