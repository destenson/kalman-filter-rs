+// ---------------------------------------------------------------------------
+// The filter is only read, never stepped
+// ---------------------------------------------------------------------------
+
+#[test]
+fn smoothing_leaves_the_filter_unchanged() {
+    let kf = constant_velocity();
+    let (before_state, before_covariance) = (kf.state().to_vec(), kf.covariance().to_vec());
+    let _ = rts_smooth(&kf, &measurements(10)).unwrap();
+    assert_eq!(kf.state(), before_state.as_slice());
+    assert_eq!(kf.covariance(), before_covariance.as_slice());
+}
+
+#[test]
+fn smoothing_starts_from_the_filters_current_estimate() {
+    // A filter that has already taken one step treats its current estimate as the prior.
+    let mut warmed = random_walk();
+    warmed.predict().unwrap();
+    warmed.update(&[0.3]).unwrap();
+
+    let z = measurements(6);
+    let smoothed = rts_smooth(&warmed, &z).unwrap();
+
+    // Equivalent to a filter constructed directly from the warmed estimate.
+    let rebuilt = LinearKalmanFilter::<f64>::new(
+        1,
+        1,
+        warmed.state(),
+        warmed.covariance(),
+        &[1.0],
+        &[0.1],
+        &[1.0],
+        &[0.5],
+    )
+    .unwrap();
+    let rebuilt_smoothed = rts_smooth(&rebuilt, &z).unwrap();
+    assert_eq!(smoothed.states(), rebuilt_smoothed.states());
+    assert_eq!(smoothed.covariances(), rebuilt_smoothed.covariances());
+}
