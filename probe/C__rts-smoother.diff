+// ---------------------------------------------------------------------------
+// Boundaries and shape
+// ---------------------------------------------------------------------------
+
+#[test]
+fn last_smoothed_step_is_the_filtered_step() {
+    for (kf, z) in [(random_walk(), measurements(10)), (constant_velocity(), measurements(10))] {
+        let m = kf.measurement_dim();
+        let mut forward = kf.clone();
+        for zi in z.chunks_exact(m) {
+            forward.predict().unwrap();
+            forward.update(zi).unwrap();
+        }
+        let smoothed = rts_smooth(&kf, &z).unwrap();
+        let last = smoothed.len() - 1;
+        assert_eq!(smoothed.state(last).unwrap(), forward.state());
+        assert_eq!(smoothed.covariance(last).unwrap(), forward.covariance());
+    }
+}
+
+#[test]
+fn single_measurement_smooths_to_the_filtered_estimate() {
+    let kf = random_walk();
+    let smoothed = rts_smooth(&kf, &[1.25]).unwrap();
+    let mut forward = kf.clone();
+    forward.predict().unwrap();
+    forward.update(&[1.25]).unwrap();
+    assert_eq!(smoothed.state(0).unwrap(), forward.state());
+    assert_eq!(smoothed.covariance(0).unwrap(), forward.covariance());
+}
+
+#[test]
+fn flat_blocks_agree_with_per_step_accessors() {
+    let kf = constant_velocity();
+    let z = measurements(12);
+    let smoothed = rts_smooth(&kf, &z).unwrap();
+    let n = 2;
+    assert_eq!(smoothed.state_dim(), n);
+    assert_eq!(smoothed.len(), z.len());
+    assert_eq!(smoothed.states().len(), z.len() * n);
+    assert_eq!(smoothed.covariances().len(), z.len() * n * n);
+    for k in 0..z.len() {
+        assert_eq!(smoothed.state(k).unwrap(), &smoothed.states()[k * n..(k + 1) * n]);
+        assert_eq!(smoothed.covariance(k).unwrap(), &smoothed.covariances()[k * n * n..(k + 1) * n * n]);
+    }
+}
