+// ===========================================================================
+// Update after a controlled predict
+// ===========================================================================
+
+#[test]
+fn update_after_controlled_predict_matches_a_filter_started_at_the_analytic_state() {
+    // 10 acceleration steps from rest give x = [50, 10] and P = [[101, 10], [10, 1]]
+    // (the first test). An update on that filter must therefore agree with an
+    // update on a filter constructed directly at that state.
+    let mut controlled = LinearKalmanFilter::<f64>::new_with_control(
+        2,
+        1,
+        1,
+        &[0.0, 0.0],
+        &P0,
+        &F,
+        &[0.0; 4],
+        &H,
+        &R,
+        &[0.5, 1.0],
+    )
+    .unwrap();
+    for _ in 0..10 {
+        controlled.predict_with_control(&[1.0]).unwrap();
+    }
+
+    let mut direct =
+        LinearKalmanFilter::<f64>::new(2, 1, &[50.0, 10.0], &[101.0, 10.0, 10.0, 1.0], &F, &[0.0; 4], &H, &R)
+            .unwrap();
+
+    controlled.update(&[52.0]).unwrap();
+    direct.update(&[52.0]).unwrap();
+    close_f64(controlled.state(), direct.state(), 1e-12, "state after update");
+    close_f64(controlled.covariance(), direct.covariance(), 1e-12, "covariance after update");
+}
