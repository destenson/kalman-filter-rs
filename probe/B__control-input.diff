     }
 }
 
+/// out += A·x, where A is r×c.
+pub(crate) fn add_mul_vec<T: Float>(a: &[T], x: &[T], out: &mut [T], r: usize, c: usize) {
+    for i in 0..r {
+        out[i] = out[i] + dot(&a[i * c..(i + 1) * c], &x[..c]);
+    }
+}
+
 fn dot<T: Float>(a: &[T], b: &[T]) -> T {
     a.iter().zip(b).fold(T::zero(), |acc, (&x, &y)| acc + x * y)
 }
