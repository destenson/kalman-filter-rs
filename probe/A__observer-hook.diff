+// ---------------------------------------------------------------------------
+// Cost
+// ---------------------------------------------------------------------------
+
+#[test]
+fn update_does_not_allocate_with_or_without_an_observer() {
+    let mut kf = cv_filter();
+    let calls = Arc::new(AtomicUsize::new(0));
+
+    // No observer registered.
+    kf.predict().unwrap();
+    kf.update(&[0.3]).unwrap(); // warm up
+    alloc_counter::reset();
+    for k in 0..100 {
+        kf.predict().unwrap();
+        kf.update(&[0.01 * k as f64]).unwrap();
+    }
+    assert_eq!(alloc_counter::count(), 0, "no allocation without an observer");
+
+    // Observer registered: registration allocates, steady state does not.
+    let counter = Arc::clone(&calls);
+    kf.set_innovation_observer(move |_: &Innovation<'_, f64>| {
+        counter.fetch_add(1, Ordering::Relaxed);
+    });
+    kf.predict().unwrap();
+    kf.update(&[0.3]).unwrap(); // warm up
+    alloc_counter::reset();
+    for k in 0..100 {
+        kf.predict().unwrap();
+        kf.update(&[0.01 * k as f64]).unwrap();
+    }
+    assert_eq!(alloc_counter::count(), 0, "no allocation with an observer");
+    assert_eq!(calls.load(Ordering::Relaxed), 101);
+
+    // Clearing the observer returns to the no-observer path.
+    kf.clear_innovation_observer();
+    alloc_counter::reset();
+    for k in 0..100 {
+        kf.predict().unwrap();
+        kf.update(&[0.01 * k as f64]).unwrap();
+    }
+    assert_eq!(alloc_counter::count(), 0, "no allocation after clearing the observer");
+    assert_eq!(calls.load(Ordering::Relaxed), 101);
+}
