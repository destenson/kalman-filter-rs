+// ---------------------------------------------------------------------------
+// Copying
+// ---------------------------------------------------------------------------
+
+#[test]
+fn clone_copies_the_estimate_but_not_the_observer() {
+    let mut kf = cv_filter();
+    let (reports, observer) = collect();
+    kf.set_innovation_observer(observer);
+    kf.predict().unwrap();
+    kf.update(&[0.4]).unwrap();
+    assert_eq!(snapshot(&reports).len(), 1);
+
+    let mut copy = kf.clone();
+    assert_eq!(copy.state(), kf.state());
+    assert_eq!(copy.covariance(), kf.covariance());
+
+    copy.update(&[0.5]).unwrap();
+    kf.update(&[0.5]).unwrap();
+    assert_eq!(snapshot(&reports).len(), 2, "only the original filter reports");
+    assert_eq!(copy.state(), kf.state());
+}
