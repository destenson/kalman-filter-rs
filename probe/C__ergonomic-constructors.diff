+#[test]
+fn constant_velocity_rejects_bad_models() {
+    assert!(matches!(LinearKalmanFilter::<f64>::constant_velocity(0, 0.1, 0.01, 0.5), Err(KalmanError::ZeroDimension)));
+    assert!(matches!(LinearKalmanFilter::<f64>::constant_velocity(DIMS, -0.1, 0.01, 0.5), Err(KalmanError::InvalidNoiseCovariance)));
+    assert!(matches!(LinearKalmanFilter::<f64>::constant_velocity(DIMS, 0.1, -0.01, 0.5), Err(KalmanError::InvalidNoiseCovariance)));
+    assert!(matches!(LinearKalmanFilter::<f64>::constant_velocity(DIMS, 0.1, 0.01, -0.5), Err(KalmanError::InvalidNoiseCovariance)));
+    assert!(matches!(LinearKalmanFilter::<f64>::constant_velocity(DIMS, f64::NAN, 0.01, 0.5), Err(KalmanError::NonFiniteInput)));
+    assert!(matches!(
+        LinearKalmanFilter::<f64>::constant_velocity(usize::MAX / 2 + 1, 0.1, 0.01, 0.5),
+        Err(KalmanError::DimensionMismatch { .. })
+    ));
+}
