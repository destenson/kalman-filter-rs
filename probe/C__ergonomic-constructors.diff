+#[test]
+fn constant_velocity_accepts_a_zero_time_step() {
+    // dt = 0 freezes the model: F = I and Q = 0, which is a valid (singular) noise covariance.
+    let mut kf = LinearKalmanFilter::<f64>::constant_velocity(DIMS, 0.0, 0.01, 0.5).expect("model");
+    kf.predict().expect("predict");
+    kf.update(&[1.0, 2.0]).expect("update");
+    assert!(kf.state().iter().all(|v| v.is_finite()));
+}
