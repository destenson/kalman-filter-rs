@@ -0,0 +1,418 @@
+//! Tests for the ergonomic constructors of the linear filter:
+//! [`LinearKalmanFilter::builder`], [`LinearKalmanFilterBuilder::constant_velocity`] and
+//! [`LinearKalmanFilter::constant_velocity`].
+//!
+//! Each helper is compared with a filter built directly through [`LinearKalmanFilter::new`]
+//! from dense row-major matrices, over 20 predict/update steps. The comparison is exact: a
+//! helper assembles the same model, so it must produce bit-identical states and covariances.
+
+use core::fmt::Debug;
+
+use kalman_filters::KalmanError;
+use kalman_filters::linear::{Covariance, FilterAllocator, LinearKalmanFilter, LinearKalmanFilterBuilder};
+use kalman_filters::nalgebra::{DefaultAllocator, Dim, RealField, U1, U2, U4};
+use kalman_filters::nalgebra::convert;
+
+/// Spatial dimensions of the constant-velocity models used below.
+const DIMS: usize = 2;
+const N: usize = 2 * DIMS;
+const M: usize = DIMS;
+const STEPS: usize = 20;
+
+/// Dense row-major matrices of the constant-velocity model, written out here independently of
+/// the code under test.
+struct Model<T> {
+    f: Vec<T>,
+    h: Vec<T>,
+    p0: Vec<T>,
+    q: Vec<T>,
+    r: Vec<T>,
+}
+
+impl<T: RealField + Copy> Model<T> {
+    /// `P0 = I` and `Q` from a white-noise-acceleration intensity `q`.
+    fn constant_velocity(dt: T, q: T, r: T) -> Self {
+        let (zero, one) = (T::zero(), T::one());
+        let (two, three) = (convert::<f64, T>(2.0), convert::<f64, T>(3.0));
+        let (mut f, mut h) = (vec![zero; N * N], vec![zero; M * N]);
+        let (mut p0, mut q_matrix, mut r_matrix) = (vec![zero; N * N], vec![zero; N * N], vec![zero; M * M]);
+        let (q_position, q_cross, q_velocity) = (q * dt * dt * dt / three, q * dt * dt / two, q * dt);
+        for i in 0..DIMS {
+            let velocity = DIMS + i;
+            f[i * N + i] = one;
+            f[i * N + velocity] = dt;
+            f[velocity * N + velocity] = one;
+
+            p0[i * N + i] = one;
+            p0[velocity * N + velocity] = one;
+
+            q_matrix[i * N + i] = q_position;
+            q_matrix[i * N + velocity] = q_cross;
+            q_matrix[velocity * N + i] = q_cross;
+            q_matrix[velocity * N + velocity] = q_velocity;
+
+            h[i * N + i] = one;
+            r_matrix[i * M + i] = r;
+        }
+        Self { f, h, p0, q: q_matrix, r: r_matrix }
+    }
+}
+
+fn dense_diagonal<T: RealField + Copy>(entries: &[T]) -> Vec<T> {
+    let d = entries.len();
+    let mut matrix = vec![T::zero(); d * d];
+    for (i, &entry) in entries.iter().enumerate() {
+        matrix[i * d + i] = entry;
+    }
+    matrix
+}
+
+/// A fixed measurement sequence, so both filters see exactly the same data.
+fn measurement<T: RealField + Copy>(step: usize) -> [T; M] {
+    let k = step as f64;
+    [convert::<f64, T>(0.4 * k - 2.0), convert::<f64, T>(0.15 * k + 1.0)]
+}
+
+fn drive<T, N, M>(kf: &mut LinearKalmanFilter<T, N, M>)
+where
+    T: RealField + Copy,
+    N: Dim,
+    M: Dim,
+    DefaultAllocator: FilterAllocator<N, M>,
+{
+    for step in 0..STEPS {
+        kf.predict().expect("predict");
+        kf.update(&measurement(step)).expect("update");
+    }
+}
+
+fn assert_same<T, N, M>(helper: &LinearKalmanFilter<T, N, M>, reference: &LinearKalmanFilter<T, N, M>)
+where
+    T: RealField + Copy + Debug,
+    N: Dim,
+    M: Dim,
+    DefaultAllocator: FilterAllocator<N, M>,
+{
+    assert_eq!(helper.state(), reference.state(), "state after {STEPS} steps");
+    assert_eq!(helper.covariance(), reference.covariance(), "covariance after {STEPS} steps");
+}
+
+/// Builder with the three covariance inputs given as full matrices.
+fn builder_full_matches_new<T: RealField + Copy + Debug>(dt: T, q: T, r: T) {
+    let model = Model::<T>::constant_velocity(dt, q, r);
+    let x0 = vec![T::zero(); N];
+    let mut reference =
+        LinearKalmanFilter::<T>::new(N, M, &x0, &model.p0, &model.f, &model.q, &model.h, &model.r).expect("reference");
+    let mut built = LinearKalmanFilter::<T>::builder(&model.f, &model.h)
+        .initial_covariance(model.p0.as_slice())
+        .process_noise(model.q.as_slice())
+        .measurement_noise(model.r.as_slice())
+        .build()
+        .expect("builder with full matrices");
+    drive(&mut reference);
+    drive(&mut built);
+    assert_same(&built, &reference);
+}
+
+/// Builder with `P0` and `R` diagonal and `Q` full, against the dense equivalent for `new`.
+fn builder_diagonal_matches_new<T: RealField + Copy + Debug>(dt: T, q: T, r: T) {
+    let model = Model::<T>::constant_velocity(dt, q, r);
+    let p0_diagonal = [T::one(); N];
+    let r_diagonal = [r; M];
+    let x0 = vec![T::zero(); N];
+    let mut reference = LinearKalmanFilter::<T>::new(
+        N,
+        M,
+        &x0,
+        &dense_diagonal(&p0_diagonal),
+        &model.f,
+        &model.q,
+        &model.h,
+        &dense_diagonal(&r_diagonal),
+    )
+    .expect("reference");
+    let mut built = LinearKalmanFilter::<T>::builder(&model.f, &model.h)
+        .initial_covariance(Covariance::diagonal(&p0_diagonal))
+        .process_noise(model.q.as_slice())
+        .measurement_noise(Covariance::diagonal(&r_diagonal))
+        .build()
+        .expect("builder with diagonal matrices");
+    // The diagonal input must reproduce the reference model exactly, not only its results.
+    assert_eq!(dense_diagonal(&p0_diagonal), model.p0);
+    assert_eq!(dense_diagonal(&r_diagonal), model.r);
+    drive(&mut reference);
+    drive(&mut built);
+    assert_same(&built, &reference);
+}
+
+/// Builder with all three covariance inputs as single variances (`σ²·I`).
+fn builder_scalar_matches_new<T: RealField + Copy + Debug>() {
+    let model = Model::<T>::constant_velocity(T::one(), T::zero(), T::zero());
+    let (p0, q, r) = (convert::<f64, T>(4.0), convert::<f64, T>(0.25), convert::<f64, T>(0.5));
+    let (p0_matrix, q_matrix, r_matrix) = (dense_diagonal(&[p0; N]), dense_diagonal(&[q; N]), dense_diagonal(&[r; M]));
+    let x0 = vec![T::zero(); N];
+    let mut reference =
+        LinearKalmanFilter::<T>::new(N, M, &x0, &p0_matrix, &model.f, &q_matrix, &model.h, &r_matrix).expect("reference");
+    let mut built = LinearKalmanFilter::<T>::builder(&model.f, &model.h)
+        .initial_covariance(p0)
+        .process_noise(q)
+        .measurement_noise(r)
+        .build()
+        .expect("builder with scalar variances");
+    drive(&mut reference);
+    drive(&mut built);
+    assert_same(&built, &reference);
+}
+
+/// Both constant-velocity entry points against `new` with the same model.
+fn constant_velocity_matches_new<T: RealField + Copy + Debug>(dt: T, q: T, r: T) {
+    let model = Model::<T>::constant_velocity(dt, q, r);
+    let x0 = vec![T::zero(); N];
+    let mut reference =
+        LinearKalmanFilter::<T>::new(N, M, &x0, &model.p0, &model.f, &model.q, &model.h, &model.r).expect("reference");
+    let mut preset = LinearKalmanFilter::<T>::constant_velocity(DIMS, dt, q, r).expect("constant_velocity");
+    let mut preset_builder = LinearKalmanFilterBuilder::<T>::constant_velocity(DIMS, dt, q, r)
+        .expect("constant_velocity builder")
+        .build()
+        .expect("build");
+    drive(&mut reference);
+    drive(&mut preset);
+    drive(&mut preset_builder);
+    assert_same(&preset, &reference);
+    assert_same(&preset_builder, &reference);
+}
