+#[test]
+fn constant_velocity_predict_uses_velocity_and_dt() {
+    let mut kf = LinearKalmanFilterBuilder::<f64>::constant_velocity(DIMS, 0.5, 0.0, 0.25)
+        .expect("model")
+        .initial_state(&[10.0, 20.0, 2.0, -1.0])
+        .build()
+        .expect("build");
+    kf.predict().expect("predict");
+    // Positions advance by velocity·dt; velocities are unchanged when Q = 0.
+    assert_eq!(&kf.state()[..DIMS], &[10.0 + 2.0 * 0.5, 20.0 - 1.0 * 0.5]);
+    assert_eq!(&kf.state()[DIMS..], &[2.0, -1.0]);
+}
