+#[test]
+fn builder_rejects_static_dimensions_that_disagree() {
+    let model = Model::<f64>::constant_velocity(0.1, 0.05, 0.25);
+    let result = LinearKalmanFilter::<f64, U2, U1>::builder(&model.f, &model.h)
+        .initial_covariance(model.p0.as_slice())
+        .process_noise(model.q.as_slice())
+        .measurement_noise(model.r.as_slice())
+        .build();
+    assert!(matches!(result, Err(KalmanError::DimensionMismatch { .. })));
+    // The constant-velocity preset reads the same static dimensions, so it must reject them too.
+    assert!(matches!(
+        LinearKalmanFilter::<f64, U2, U1>::constant_velocity(DIMS, 0.1, 0.05, 0.25),
+        Err(KalmanError::DimensionMismatch { .. })
+    ));
+}
