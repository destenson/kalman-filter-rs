@@ -0,0 +1,337 @@
+//! Ergonomic construction for the linear filter: [`LinearKalmanFilterBuilder`] and the
+//! constant-velocity preset [`LinearKalmanFilter::constant_velocity`].
+//!
+//! The builder supplies the two pieces a caller usually has — the model matrices `F` and `H` —
+//! and lets the rest be written in the form that is natural for the problem: a full matrix, a
+//! diagonal, or one variance `σ²` meaning `σ²·I`. The initial state defaults to zero.
+//!
+//! Every path ends in [`LinearKalmanFilter::new`]. The builder only fills in defaults and
+//! writes a diagonal or scalar input out as a dense row-major matrix; the length, finiteness
+//! and positive-semidefinite checks, and therefore every error about them, are `new`'s.
+//! The few decisions the builder makes itself are: a required piece that is missing
+//! (`BuilderIncomplete`), a diagonal whose length disagrees with the dimension read from `F`
+//! (`DimensionMismatch`, the same error `new` gives for a dense matrix of that length), and
+//! dimension arithmetic that overflows or cannot be allocated (`DimensionMismatch`).
+
+use core::marker::PhantomData;
+
+use nalgebra::{convert, DefaultAllocator, Dim, Dyn, RealField};
+
+use super::{FilterAllocator, LinearKalmanFilter};
+use crate::error::{KalmanError, KalmanResult};
+
+/// A covariance supplied to a [`LinearKalmanFilterBuilder`]: a full matrix, a diagonal, or a
+/// single variance `σ²` meaning `σ²·I`.
+///
+/// A slice, an array or a `Vec` converts to [`Full`](Self::Full), the same convention as
+/// [`LinearKalmanFilter::new`], so a full matrix needs no wrapper. [`diagonal`](Self::diagonal)
+/// is the explicit diagonal form, and a bare scalar means `σ²·I`.
+///
+/// ```
+/// use kalman_filters::linear::{Covariance, LinearKalmanFilter};
+/// let f = [1.0, 1.0, 0.0, 1.0];
+/// let h = [1.0, 0.0];
+/// let kf = LinearKalmanFilter::<f64>::builder(&f, &h)
+///     .initial_covariance(Covariance::diagonal(&[10.0, 1.0]))
+///     .process_noise(0.01)
+///     .measurement_noise(&[0.25])
+///     .build()?;
+/// assert_eq!(kf.state(), [0.0; 2].as_slice());
+/// # Ok::<(), kalman_filters::KalmanError>(())
+/// ```
+#[derive(Clone, Debug)]
+pub enum Covariance<T> {
+    /// A full d×d row-major matrix.
+    Full(Vec<T>),
+    /// The d diagonal entries of a d×d matrix; every off-diagonal is zero.
+    Diagonal(Vec<T>),
+    /// One variance `σ²` used for every state: `σ²·I`.
+    Scalar(T),
+}
+
+impl<T: Copy> Covariance<T> {
+    /// The diagonal entries of a d×d covariance; `entries.len()` must be d.
+    pub fn diagonal(entries: &[T]) -> Self {
+        Self::Diagonal(entries.to_vec())
+    }
+
+    /// A full d×d row-major matrix.
+    pub fn full(entries: &[T]) -> Self {
+        Self::Full(entries.to_vec())
+    }
+
+    /// The single variance `σ²` of `σ²·I`.
+    pub fn scalar(variance: T) -> Self {
+        Self::Scalar(variance)
+    }
+}
+
+impl<T: Copy> From<T> for Covariance<T> {
+    fn from(variance: T) -> Self {
+        Self::Scalar(variance)
+    }
+}
+
+impl<T: Copy> From<&[T]> for Covariance<T> {
+    fn from(entries: &[T]) -> Self {
+        Self::Full(entries.to_vec())
+    }
+}
+
+impl<T: Copy, const K: usize> From<[T; K]> for Covariance<T> {
+    fn from(entries: [T; K]) -> Self {
+        Self::Full(entries.to_vec())
+    }
+}
+
+impl<T: Copy, const K: usize> From<&[T; K]> for Covariance<T> {
+    fn from(entries: &[T; K]) -> Self {
+        Self::Full(entries.to_vec())
+    }
+}
+
+impl<T> From<Vec<T>> for Covariance<T> {
+    fn from(entries: Vec<T>) -> Self {
+        Self::Full(entries)
+    }
+}
+
+impl<T: Copy> From<&Vec<T>> for Covariance<T> {
+    fn from(entries: &Vec<T>) -> Self {
+        Self::Full(entries.clone())
+    }
+}
+
+impl<T: RealField + Copy> Covariance<T> {
+    /// Writes the covariance out as a dense row-major `d×d` matrix.
+    ///
+    /// A full matrix is passed through untouched, so `new` applies its usual length,
+    /// finiteness and PSD tests to the caller's values. The other two forms are exactly
+    /// symmetric by construction. A diagonal whose length is not `d` is rejected here,
+    /// because it cannot be laid out as a `d×d` matrix at all.
+    fn dense(self, d: usize) -> KalmanResult<Vec<T>> {
+        match self {
+            Self::Full(entries) => Ok(entries),
+            Self::Diagonal(entries) => {
+                if entries.len() != d {
+                    return Err(KalmanError::DimensionMismatch { expected: (d, d), actual: (entries.len(), 1) });
+                }
+                let mut dense = filled(area(d, d)?, T::zero())?;
+                for (i, entry) in entries.into_iter().enumerate() {
+                    dense[i * d + i] = entry;
+                }
+                Ok(dense)
+            }
+            Self::Scalar(variance) => {
+                let mut dense = filled(area(d, d)?, T::zero())?;
+                for i in 0..d {
+                    dense[i * d + i] = variance;
+                }
+                Ok(dense)
+            }
+        }
+    }
+}
+
+/// Builder for a [`LinearKalmanFilter`], starting from [`LinearKalmanFilter::builder`] or a
+/// preset such as [`constant_velocity`](Self::constant_velocity).
+///
+/// The caller supplies `F` (n×n) and `H` (m×n); n and m are read from their lengths. The
+/// initial state `x0` defaults to zero. `P0`, `Q` and `R` are required, because the builder
+/// cannot guess their scale; each may be a full matrix, a diagonal or one variance. A missing
+/// piece is `BuilderIncomplete`. A preset fills every piece, and any of them can be replaced
+/// before `build`.
+///
+/// ```
+/// use kalman_filters::linear::LinearKalmanFilter;
+/// let f = [1.0, 0.1, 0.0, 1.0];
+/// let h = [1.0, 0.0];
+/// let mut kf = LinearKalmanFilter::<f32>::builder(&f, &h)
+///     .initial_state(&[0.0, 1.0])
+///     .initial_covariance([1.0, 0.0, 0.0, 1.0])
+///     .process_noise(1e-3)
+///     .measurement_noise(0.1)
+///     .build()?;
+/// kf.predict()?;
+/// kf.update(&[0.5])?;
+/// # Ok::<(), kalman_filters::KalmanError>(())
+/// ```
+#[derive(Clone, Debug)]
+pub struct LinearKalmanFilterBuilder<T: RealField + Copy, N: Dim = Dyn, M: Dim = Dyn>
+where
+    DefaultAllocator: FilterAllocator<N, M>,
+{
+    /// Required at construction, so it is not optional here.
+    f: Vec<T>,
+    /// Required at construction, so it is not optional here.
+    h: Vec<T>,
+    x0: Option<Vec<T>>,
+    p0: Option<Covariance<T>>,
+    q: Option<Covariance<T>>,
+    r: Option<Covariance<T>>,
+    /// The filter's dimension kinds, which `build` passes on to `new`.
+    dimensions: PhantomData<fn() -> (N, M)>,
+}
+
+impl<T: RealField + Copy, N: Dim, M: Dim> LinearKalmanFilterBuilder<T, N, M>
+where
+    DefaultAllocator: FilterAllocator<N, M>,
+{
+    /// The initial state, length n. Defaults to zero.
+    pub fn initial_state(mut self, x0: &[T]) -> Self {
+        self.x0 = Some(x0.to_vec());
+        self
+    }
+
+    /// The initial covariance `P0`, n×n. Required.
+    pub fn initial_covariance(mut self, p0: impl Into<Covariance<T>>) -> Self {
+        self.p0 = Some(p0.into());
+        self
+    }
+
+    /// The process-noise covariance `Q`, n×n. Required.
+    pub fn process_noise(mut self, q: impl Into<Covariance<T>>) -> Self {
+        self.q = Some(q.into());
+        self
+    }
+
+    /// The measurement-noise covariance `R`, m×m. Required.
+    pub fn measurement_noise(mut self, r: impl Into<Covariance<T>>) -> Self {
+        self.r = Some(r.into());
+        self
+    }
+
+    /// Validates the assembled model by calling [`LinearKalmanFilter::new`].
+    ///
+    /// Errors: `BuilderIncomplete` for a missing piece, and `new`'s errors for a model that
+    /// is the wrong shape, non-finite, or not PSD. A static `N`/`M` that disagrees with the
+    /// dimensions of `F`/`H` is `DimensionMismatch`.
+    pub fn build(self) -> KalmanResult<LinearKalmanFilter<T, N, M>> {
+        let p0 = self.p0.ok_or_else(|| KalmanError::BuilderIncomplete("initial_covariance".into()))?;
+        let q = self.q.ok_or_else(|| KalmanError::BuilderIncomplete("process_noise".into()))?;
+        let r = self.r.ok_or_else(|| KalmanError::BuilderIncomplete("measurement_noise".into()))?;
+
+        // n and m come from the two supplied shapes. A malformed `F` or `H` produces lengths
+        // that disagree with n and m below, which `new` reports under its own length rule. An
+        // empty `F` gives n = 0 and m = 0 here, so `new` reports `ZeroDimension`, not a
+        // division by zero.
+        let n = self.f.len().isqrt();
+        let m = self.h.len().checked_div(n).unwrap_or(0);
+        let (p0, q, r) = (p0.dense(n)?, q.dense(n)?, r.dense(m)?);
+        let x0 = match self.x0 {
+            Some(x0) => x0,
+            None => filled(n, T::zero())?,
+        };
+        LinearKalmanFilter::new(n, m, &x0, &p0, &self.f, &q, &self.h, &r)
+    }
+
+    /// A builder preset for the constant-velocity model over `dims` spatial dimensions, time
+    /// step `dt`, process-noise intensity `q` and measurement variance `r`; positions are
+    /// measured directly.
+    ///
+    /// The state is `[position; velocity]` with 2·dims entries, and
+    /// - `F = [[I, dt·I], [0, I]]`,
+    /// - `H = [I, 0]` (dims rows of 2·dims entries),
+    /// - `Q = q·[[dt³/3·I, dt²/2·I], [dt²/2·I, dt·I]]`, the discrete white-noise-acceleration
+    ///   model for a noise intensity `q` (variance per unit time³),
+    /// - `R = r·I`, with `x0 = 0` and `P0 = I` as the defaults; either can be overridden on
+    ///   the returned builder before `build`.
+    ///
+    /// Returns an error only for dimensions that do not fit: `DimensionMismatch` if 2·dims or
+    /// the matrices it implies overflow or cannot be allocated. Everything else is checked by
+    /// [`build`](Self::build) under `new`'s rules: `ZeroDimension` for `dims == 0`, and
+    /// `NonFiniteInput` or `InvalidNoiseCovariance` for values that are not finite or make the
+    /// white-noise-acceleration `Q` indefinite (a negative `q` or `r`, and a negative `dt` when
+    /// `q > 0`). A static `N`/`M` that disagrees with 2·dims/dims is `DimensionMismatch`.
+    pub fn constant_velocity(dims: usize, dt: T, q: T, r: T) -> KalmanResult<Self> {
+        let n = dims
+            .checked_mul(2)
+            .ok_or(KalmanError::DimensionMismatch { expected: (dims, 2), actual: (usize::MAX, 1) })?;
+        let mut f = filled(area(n, n)?, T::zero())?;
+        let mut h = filled(area(dims, n)?, T::zero())?;
+        let mut q_matrix = filled(area(n, n)?, T::zero())?;
+        let mut r_matrix = filled(area(dims, dims)?, T::zero())?;
+
+        let (two, three) = (convert::<f64, T>(2.0), convert::<f64, T>(3.0));
+        let q_position = q * dt * dt * dt / three;
+        let q_cross = q * dt * dt / two;
+        let q_velocity = q * dt;
+        for i in 0..dims {
+            let velocity = dims + i;
+            f[i * n + i] = T::one();
+            f[i * n + velocity] = dt;
+            f[velocity * n + velocity] = T::one();
+
+            q_matrix[i * n + i] = q_position;
+            q_matrix[i * n + velocity] = q_cross;
+            q_matrix[velocity * n + i] = q_cross;
+            q_matrix[velocity * n + velocity] = q_velocity;
+
+            h[i * n + i] = T::one();
+            r_matrix[i * dims + i] = r;
+        }
+
+        Ok(Self {
+            f,
+            h,
+            x0: None,
+            p0: Some(Covariance::scalar(T::one())),
+            q: Some(Covariance::Full(q_matrix)),
+            r: Some(Covariance::Full(r_matrix)),
+            dimensions: PhantomData,
+        })
+    }
+}
+
+impl<T: RealField + Copy, N: Dim, M: Dim> LinearKalmanFilter<T, N, M>
+where
+    DefaultAllocator: FilterAllocator<N, M>,
+{
+    /// Starts a builder from the model matrices: `f` is n×n and `h` is m×n, both row-major.
+    /// n and m are read from their lengths; the initial state defaults to zero.
+    ///
+    /// Prefer this to calling `new` with eight arguments, and set `P0`, `Q` and `R` on the
+    /// result. A model whose `F` is not square, or whose `H` does not hold whole rows of n
+    /// entries, is reported by `build()` as `DimensionMismatch`.
+    pub fn builder(f: &[T], h: &[T]) -> LinearKalmanFilterBuilder<T, N, M> {
+        LinearKalmanFilterBuilder {
+            f: f.to_vec(),
+            h: h.to_vec(),
+            x0: None,
+            p0: None,
+            q: None,
+            r: None,
+            dimensions: PhantomData,
+        }
+    }
+
+    /// A filter for the constant-velocity model over `dims` spatial dimensions, time step
+    /// `dt`, process-noise intensity `q` and measurement variance `r`; positions are measured
+    /// directly.
+    ///
+    /// This is the one-shot form of
+    /// [`LinearKalmanFilterBuilder::constant_velocity`]: it presets the whole model and
+    /// builds, so a caller that wants a different `x0` or `P0` should start from the builder
+    /// instead.
+    pub fn constant_velocity(dims: usize, dt: T, q: T, r: T) -> KalmanResult<Self> {
+        LinearKalmanFilterBuilder::<T, N, M>::constant_velocity(dims, dt, q, r)?.build()
+    }
+}
+
+/// `rows·cols`, with the product overflow-checked (B19).
+fn area(rows: usize, cols: usize) -> KalmanResult<usize> {
+    rows.checked_mul(cols).ok_or(KalmanError::DimensionMismatch { expected: (rows, cols), actual: (usize::MAX, 1) })
+}
+
+/// `len` copies of `value`, reporting an allocation failure as an error instead of aborting.
+/// `len` is derived from a caller-supplied dimension, so it can be arbitrarily large. There is
+/// no allocation-specific error, so an impossible size is reported as a dimension the filter
+/// cannot serve.
+fn filled<T: Copy>(len: usize, value: T) -> KalmanResult<Vec<T>> {
+    let mut values = Vec::new();
+    values
+        .try_reserve_exact(len)
+        .map_err(|_| KalmanError::DimensionMismatch { expected: (len, 1), actual: (usize::MAX, 1) })?;
+    values.resize(len, value);
+    Ok(values)
+}
