+#[test]
+fn builder_matches_new_with_static_dimensions() {
+    let model = Model::<f64>::constant_velocity(0.1, 0.05, 0.25);
+    let x0 = vec![0.0; N];
+    let mut reference =
+        LinearKalmanFilter::<f64>::new(N, M, &x0, &model.p0, &model.f, &model.q, &model.h, &model.r).expect("reference");
+    let mut built = LinearKalmanFilter::<f64, U4, U2>::builder(&model.f, &model.h)
+        .initial_covariance(model.p0.as_slice())
+        .process_noise(model.q.as_slice())
+        .measurement_noise(model.r.as_slice())
+        .build()
+        .expect("static-size build");
+    let mut preset = LinearKalmanFilter::<f64, U4, U2>::constant_velocity(DIMS, 0.1, 0.05, 0.25).expect("static preset");
+    drive(&mut reference);
+    drive(&mut built);
+    drive(&mut preset);
+    assert_eq!(built.state(), reference.state());
