+#[test]
+fn missing_pieces_are_errors() {
+    let (f, h) = ([1.0], [1.0]);
+    let (p0, q, r) = ([1.0], [0.1], [0.5]);
+    let missing = |field: &str, result: Result<LinearKalmanFilter<f64>, KalmanError>| match result {
+        Err(KalmanError::BuilderIncomplete(name)) => assert_eq!(name, field),
+        other => panic!("expected BuilderIncomplete({field}), got {other:?}"),
+    };
+    missing(
+        "initial_covariance",
+        LinearKalmanFilter::<f64>::builder(&f, &h).process_noise(q).measurement_noise(r).build(),
+    );
+    missing(
+        "process_noise",
+        LinearKalmanFilter::<f64>::builder(&f, &h).initial_covariance(p0).measurement_noise(r).build(),
+    );
+    missing(
+        "measurement_noise",
+        LinearKalmanFilter::<f64>::builder(&f, &h).initial_covariance(p0).process_noise(q).build(),
+    );
+}
