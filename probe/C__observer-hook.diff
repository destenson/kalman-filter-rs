+#[test]
+fn observing_does_not_change_the_estimate() {
+    let model = || {
+        LinearKalmanFilter::<f64>::new(2, 2, &[0.3, -0.2], &[2.0, 0.5, 0.5, 1.0], &[1.0, 1.0, 0.0, 1.0],
+            &[0.02, 0.01, 0.01, 0.01], &[1.0, 0.0, 0.0, 1.0], &[0.5, 0.2, 0.2, 0.4])
+            .unwrap()
+    };
+    let mut plain = model();
+    let mut observed = model();
+    let mut observer = |_: Innovation<'_, f64>| {};
+    for k in 0..50 {
+        let z = [0.1 * k as f64, -0.05 * k as f64];
+        plain.predict().unwrap();
+        observed.predict().unwrap();
+        plain.update(&z).unwrap();
+        observed.update_with_observer(&z, &mut observer).unwrap();
+        assert_eq!(plain.state(), observed.state(), "state diverged at step {k}");
+        assert_eq!(plain.covariance(), observed.covariance(), "covariance diverged at step {k}");
+    }
+}
