+//! Tests for `LinearKalmanFilter::constant_velocity`: the preset must produce exactly
+//! the filter an equivalent model built with `new` produces, and bad input must be an
+//! error rather than a panic.
+
+use kalman_filters::linear::LinearKalmanFilter;
+use kalman_filters::{KalmanError, KalmanScalar};
+
+const STEPS: usize = 20;
+
+/// The constant-velocity model written out by hand and passed to `new`: the reference
+/// the preset is compared against.
+fn reference_constant_velocity<T: KalmanScalar>(
+    dims: usize,
+    dt: T,
+    q: T,
+    r: T,
+) -> LinearKalmanFilter<T> {
+    let n = 2 * dims;
+    let m = dims;
+    let two = T::one() + T::one();
+    let three = two + T::one();
+    let dt2 = dt * dt;
+    let dt3 = dt2 * dt;
+    let q_position = q * dt3 / three;
+    let q_cross = q * dt2 / two;
+    let q_velocity = q * dt;
+
+    let mut f = vec![T::zero(); n * n];
+    let mut p0 = vec![T::zero(); n * n];
+    let mut q_matrix = vec![T::zero(); n * n];
+    let mut h = vec![T::zero(); m * n];
+    let mut r_matrix = vec![T::zero(); m * m];
+    for i in 0..dims {
+        f[i * n + i] = T::one();
+        f[i * n + dims + i] = dt;
+        f[(dims + i) * n + dims + i] = T::one();
+        p0[i * n + i] = T::one();
+        p0[(dims + i) * n + dims + i] = T::one();
+        q_matrix[i * n + i] = q_position;
+        q_matrix[i * n + dims + i] = q_cross;
+        q_matrix[(dims + i) * n + i] = q_cross;
+        q_matrix[(dims + i) * n + dims + i] = q_velocity;
+        h[i * n + i] = T::one();
+        r_matrix[i * m + i] = r;
+    }
+
+    let x0 = vec![T::zero(); n];
+    LinearKalmanFilter::new(n, m, &x0, &p0, &f, &q_matrix, &h, &r_matrix)
+        .expect("reference constant-velocity model is valid")
+}
+
+/// Runs both filters through the same 20 predict/update steps and requires the states
+/// and covariances to be equal after every step, not just at the end.
+fn assert_same_over_20_steps<T: KalmanScalar>(
+    mut built: LinearKalmanFilter<T>,
+    mut expected: LinearKalmanFilter<T>,
+    measurements: &[Vec<T>],
+) {
+    assert_eq!(measurements.len(), STEPS);
+    assert_eq!(built.state_dim(), expected.state_dim());
+    assert_eq!(built.measurement_dim(), expected.measurement_dim());
+    assert_eq!(built.state(), expected.state(), "initial state");
+    assert_eq!(built.covariance(), expected.covariance(), "initial covariance");
+    for (k, z) in measurements.iter().enumerate() {
+        built.predict().unwrap_or_else(|e| panic!("preset filter predict at step {k}: {e}"));
+        expected.predict().unwrap_or_else(|e| panic!("new filter predict at step {k}: {e}"));
+        assert_eq!(built.state(), expected.state(), "state after predict at step {k}");
+        assert_eq!(built.covariance(), expected.covariance(), "covariance after predict at step {k}");
+        built.update(z).unwrap_or_else(|e| panic!("preset filter update at step {k}: {e}"));
+        expected.update(z).unwrap_or_else(|e| panic!("new filter update at step {k}: {e}"));
+        assert_eq!(built.state(), expected.state(), "state after update at step {k}");
+        assert_eq!(built.covariance(), expected.covariance(), "covariance after update at step {k}");
+    }
+}
+
+#[test]
+fn constant_velocity_matches_new_over_20_steps_f64() {
+    let (dims, dt, q, r) = (2usize, 0.25_f64, 0.03_f64, 0.4_f64);
+    let built = LinearKalmanFilter::<f64>::constant_velocity(dims, dt, q, r)
+        .expect("constant-velocity model is valid");
+    let expected = reference_constant_velocity::<f64>(dims, dt, q, r);
+    let measurements: Vec<Vec<f64>> =
+        (0..STEPS).map(|k| vec![(0.2 * k as f64).sin(), (0.15 * k as f64).cos()]).collect();
+    assert_same_over_20_steps(built, expected, &measurements);
+}
+
+#[test]
+fn constant_velocity_matches_new_over_20_steps_f32() {
+    let (dims, dt, q, r) = (2usize, 0.25_f32, 0.03_f32, 0.4_f32);
+    let built = LinearKalmanFilter::<f32>::constant_velocity(dims, dt, q, r)
+        .expect("constant-velocity model is valid");
+    let expected = reference_constant_velocity::<f32>(dims, dt, q, r);
+    let measurements: Vec<Vec<f32>> =
+        (0..STEPS).map(|k| vec![(0.2 * k as f32).sin(), (0.15 * k as f32).cos()]).collect();
+    assert_same_over_20_steps(built, expected, &measurements);
+}
+
+#[test]
+fn constant_velocity_one_dimension_matches_new_f64() {
+    let (dims, dt, q, r) = (1usize, 0.1_f64, 0.01_f64, 0.2_f64);
+    let built = LinearKalmanFilter::<f64>::constant_velocity(dims, dt, q, r)
+        .expect("constant-velocity model is valid");
+    let expected = reference_constant_velocity::<f64>(dims, dt, q, r);
+    let measurements: Vec<Vec<f64>> =
+        (0..STEPS).map(|k| vec![(0.4 * k as f64).sin()]).collect();
+    assert_same_over_20_steps(built, expected, &measurements);
+}
+
+#[test]
+fn constant_velocity_rejects_zero_and_negative_variance() {
+    assert!(matches!(
+        LinearKalmanFilter::<f64>::constant_velocity(2, 0.1, -0.5, 0.1),
+        Err(KalmanError::InvalidNoiseCovariance)
+    ));
+    assert!(matches!(
+        LinearKalmanFilter::<f64>::constant_velocity(2, 0.1, 0.01, -0.1),
+        Err(KalmanError::InvalidNoiseCovariance)
+    ));
+    assert!(matches!(
+        LinearKalmanFilter::<f32>::constant_velocity(2, 0.1, -0.5, 0.1),
+        Err(KalmanError::InvalidNoiseCovariance)
+    ));
+}
+
+#[test]
+fn constant_velocity_rejects_non_finite_inputs() {
+    assert!(matches!(
+        LinearKalmanFilter::<f64>::constant_velocity(2, f64::NAN, 0.01, 0.1),
+        Err(KalmanError::InvalidInput("f"))
+    ));
+    assert!(matches!(
+        LinearKalmanFilter::<f64>::constant_velocity(2, 0.1, f64::NAN, 0.1),
+        Err(KalmanError::InvalidInput("q"))
+    ));
+    assert!(matches!(
+        LinearKalmanFilter::<f64>::constant_velocity(2, 0.1, 0.01, f64::INFINITY),
+        Err(KalmanError::InvalidInput("r"))
+    ));
+    assert!(matches!(
+        LinearKalmanFilter::<f32>::constant_velocity(2, 0.1, f32::NAN, 0.1),
+        Err(KalmanError::InvalidInput("q"))
+    ));
+}
+
+#[test]
+fn constant_velocity_rejects_zero_dimensions_without_panicking() {
+    let result = LinearKalmanFilter::<f64>::constant_velocity(0, 0.1, 0.01, 0.1);
+    assert!(matches!(result, Err(KalmanError::InvalidInput(_))), "{result:?}");
+}
+
+#[test]
+fn constant_velocity_rejects_overflowing_dimensions_without_panicking() {
+    for dims in [usize::MAX, usize::MAX / 2] {
+        let result = LinearKalmanFilter::<f64>::constant_velocity(dims, 0.1, 0.01, 0.1);
+        assert!(matches!(result, Err(KalmanError::DimensionMismatch { .. })), "dims = {dims}: {result:?}");
+    }
+}
