@@ -0,0 +1,252 @@
+//! Builder for the linear Kalman filter, and a preset for the constant-velocity model.
+//!
+//! Both entry points end in [`LinearKalmanFilter::new`]. They only put matrices into the
+//! dense row-major form that `new` takes; every length, finiteness and positive
+//! semi-definiteness check is `new`'s, so the builder cannot accept a model that `new`
+//! would reject, and it adds no rule of its own. A missing required input is a
+//! [`KalmanError::BuilderIncomplete`] error.
+
+use crate::error::{KalmanError, KalmanResult};
+use crate::filter::linear::LinearKalmanFilter;
+use crate::types::KalmanScalar;
+
+/// A covariance matrix given in one of the forms a caller usually has at hand.
+///
+/// Used for `P0` and `Q` (n×n) and for `R` (m×m). The variants say nothing about
+/// validity: a negative variance, a NaN entry or an indefinite matrix is expanded as
+/// given and then rejected by [`LinearKalmanFilter::new`], exactly like a full matrix.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Covariance<T> {
+    /// A dense row-major matrix.
+    Full(Vec<T>),
+    /// The diagonal entries, one per row and column (n for P0 and Q, m for R); every
+    /// off-diagonal entry is zero. A wrong length is a dimension error at build time.
+    Diagonal(Vec<T>),
+    /// A single variance v, expanded to v·I.
+    Scalar(T),
+}
+
+impl<T: KalmanScalar> From<Vec<T>> for Covariance<T> {
+    fn from(values: Vec<T>) -> Self {
+        Self::Full(values)
+    }
+}
+
+/// Builder for a [`LinearKalmanFilter`] with the model matrices supplied field by field.
+///
+/// `F` and `H` are required. The initial state defaults to zero; `P0`, `Q` and `R` are
+/// required and each may be a full matrix, a diagonal, or a scalar variance (v·I).
+///
+/// # Example
+/// ```
+/// use kalman_filters::builders::{Covariance, LinearKalmanFilterBuilder};
+///
+/// // Constant-velocity model, one spatial dimension, measuring position.
+/// let mut kf = LinearKalmanFilterBuilder::<f64>::new(2, 1)
+///     .state_transition_matrix(vec![1.0, 0.1, 0.0, 1.0])
+///     .observation_matrix(vec![1.0, 0.0])
+///     .initial_covariance(Covariance::Scalar(1.0))
+///     .process_noise(Covariance::Diagonal(vec![0.001, 0.01]))
+///     .measurement_noise(vec![0.1])
+///     .build()
+///     .unwrap();
+///
+/// kf.predict().unwrap();
+/// kf.update(&[1.0]).unwrap();
+/// ```
+#[derive(Debug, Clone)]
+pub struct LinearKalmanFilterBuilder<T: KalmanScalar> {
+    state_dim: usize,
+    measurement_dim: usize,
+    initial_state: Option<Vec<T>>,
+    initial_covariance: Option<Covariance<T>>,
+    state_transition: Option<Vec<T>>,
+    process_noise: Option<Covariance<T>>,
+    observation: Option<Vec<T>>,
+    measurement_noise: Option<Covariance<T>>,
+}
+
+impl<T: KalmanScalar> LinearKalmanFilterBuilder<T> {
+    /// Starts a builder for a filter with state dimension `state_dim` and measurement
+    /// dimension `measurement_dim`. Both must be non-zero; that is checked on [`build`](Self::build).
+    pub fn new(state_dim: usize, measurement_dim: usize) -> Self {
+        Self {
+            state_dim,
+            measurement_dim,
+            initial_state: None,
+            initial_covariance: None,
+            state_transition: None,
+            process_noise: None,
+            observation: None,
+            measurement_noise: None,
+        }
+    }
+
+    /// Sets the initial state x0 (length n). Defaults to all zeros.
+    pub fn initial_state(mut self, state: Vec<T>) -> Self {
+        self.initial_state = Some(state);
+        self
+    }
+
+    /// Sets the initial state covariance P0 (n×n).
+    pub fn initial_covariance(mut self, covariance: impl Into<Covariance<T>>) -> Self {
+        self.initial_covariance = Some(covariance.into());
+        self
+    }
+
+    /// Sets the state transition matrix F (n×n, row-major).
+    pub fn state_transition_matrix(mut self, matrix: Vec<T>) -> Self {
+        self.state_transition = Some(matrix);
+        self
+    }
+
+    /// Sets the process noise covariance Q (n×n).
+    pub fn process_noise(mut self, noise: impl Into<Covariance<T>>) -> Self {
+        self.process_noise = Some(noise.into());
+        self
+    }
+
+    /// Sets the observation matrix H (m×n, row-major).
+    pub fn observation_matrix(mut self, matrix: Vec<T>) -> Self {
+        self.observation = Some(matrix);
+        self
+    }
+
+    /// Sets the measurement noise covariance R (m×m).
+    pub fn measurement_noise(mut self, noise: impl Into<Covariance<T>>) -> Self {
+        self.measurement_noise = Some(noise.into());
+        self
+    }
+
+    /// Builds the filter, delegating every check to [`LinearKalmanFilter::new`].
+    ///
+    /// # Errors
+    /// * `BuilderIncomplete` — `F`, `H`, `P0`, `Q` or `R` was not supplied;
+    /// * everything [`LinearKalmanFilter::new`] returns for the assembled matrices
+    ///   (`InvalidInput`, `DimensionMismatch`, `InvalidCovariance`,
+    ///   `InvalidNoiseCovariance`).
+    pub fn build(self) -> KalmanResult<LinearKalmanFilter<T>> {
+        let n = self.state_dim;
+        let m = self.measurement_dim;
+        // `new` rejects any dimension whose matrix cannot exist because its entry count
+        // overflows `usize`. The builder checks the same three products first, since it
+        // allocates the matrices before it can hand them to `new`.
+        for (rows, cols) in [(n, n), (m, m), (m, n)] {
+            rows.checked_mul(cols).ok_or_else(|| impossible_shape(rows, cols))?;
+        }
+        let f = required(self.state_transition, "state_transition_matrix")?;
+        let h = required(self.observation, "observation_matrix")?;
+        let p0 = required_covariance(self.initial_covariance, "initial_covariance", n)?;
+        let q = required_covariance(self.process_noise, "process_noise", n)?;
+        let r = required_covariance(self.measurement_noise, "measurement_noise", m)?;
+        let x0 = self.initial_state.unwrap_or_else(|| vec![T::zero(); n]);
+        LinearKalmanFilter::new(n, m, &x0, &p0, &f, &q, &h, &r)
+    }
+}
+
+/// The error for a shape whose entry count does not fit in `usize`.
+fn impossible_shape(rows: usize, cols: usize) -> KalmanError {
+    KalmanError::DimensionMismatch { expected: (rows, cols), actual: (0, 1) }
+}
+
+/// Unpacks a required dense matrix, or reports the field that is missing.
+fn required<T>(matrix: Option<Vec<T>>, name: &'static str) -> KalmanResult<Vec<T>> {
+    matrix.ok_or_else(|| KalmanError::BuilderIncomplete(name.into()))
+}
+
+/// Unpacks a required covariance and expands it to the dense matrix `new` takes.
+fn required_covariance<T: KalmanScalar>(
+    covariance: Option<Covariance<T>>,
+    name: &'static str,
+    dim: usize,
+) -> KalmanResult<Vec<T>> {
+    let covariance = covariance.ok_or_else(|| KalmanError::BuilderIncomplete(name.into()))?;
+    expand(covariance, dim)
+}
+
+/// Expands a covariance to a dense row-major matrix. Dimensions are `dim` for a scalar
+/// (v·I) and the number of supplied entries for a diagonal; a diagonal whose length is
+/// not `dim` therefore expands to a matrix of the wrong length, and `new` reports it.
+///
+/// Products are `usize`-checked because an n×n matrix that does not fit in `usize`
+/// cannot be passed to `new`; this is `new`'s dimension rule applied before allocating.
+fn expand<T: KalmanScalar>(covariance: Covariance<T>, dim: usize) -> KalmanResult<Vec<T>> {
+    match covariance {
+        Covariance::Full(values) => Ok(values),
+        Covariance::Diagonal(values) => {
+            let k = values.len();
+            let total = k.checked_mul(k).ok_or_else(|| impossible_shape(k, k))?;
+            let mut out = vec![T::zero(); total];
+            for (i, value) in values.into_iter().enumerate() {
+                out[i * k + i] = value;
+            }
+            Ok(out)
+        }
+        Covariance::Scalar(variance) => {
+            let total = dim.checked_mul(dim).ok_or_else(|| impossible_shape(dim, dim))?;
+            let mut out = vec![T::zero(); total];
+            for i in 0..dim {
+                out[i * dim + i] = variance;
+            }
+            Ok(out)
+        }
+    }
+}
+
+impl<T: KalmanScalar> LinearKalmanFilter<T> {
+    /// A constant-velocity filter over `dims` spatial dimensions, measuring positions.
+    ///
+    /// The state is positions then velocities: for spatial dimension i, position i and
+    /// velocity dims + i, so n = 2·dims and m = dims. `dt` is the time between predicts,
+    /// `q` the process-noise intensity (the power spectral density of a white
+    /// acceleration), and `r` the variance of each position measurement.
+    ///
+    /// x0 = 0, P0 = I, and per spatial dimension
+    /// F = [[1, dt], [0, 1]], H = [1 0],
+    /// Q = q·[[dt³/3, dt²/2], [dt²/2, dt]], R = r.
+    ///
+    /// Built through [`LinearKalmanFilterBuilder`], so it reaches `new` by the same route
+    /// as any builder model.
+    ///
+    /// # Errors
+    /// Same as [`LinearKalmanFilter::new`]: zero dimensions, non-finite or non-PSD
+    /// covariance input, and dimension products that overflow `usize`.
+    pub fn constant_velocity(dims: usize, dt: T, q: T, r: T) -> KalmanResult<Self> {
+        let n = dims.checked_mul(2).ok_or_else(|| impossible_shape(dims, dims))?;
+        let n2 = n.checked_mul(n).ok_or_else(|| impossible_shape(n, n))?;
+        let mn = dims.checked_mul(n).ok_or_else(|| impossible_shape(dims, n))?;
+
+        let two = T::one() + T::one();
+        let three = two + T::one();
+        let dt2 = dt * dt;
+        let dt3 = dt2 * dt;
+        let q_position = q * dt3 / three;
+        let q_cross = q * dt2 / two;
+        let q_velocity = q * dt;
+
+        let mut f = vec![T::zero(); n2];
+        let mut p0 = vec![T::zero(); n2];
+        let mut q_matrix = vec![T::zero(); n2];
+        let mut h = vec![T::zero(); mn];
+        for i in 0..dims {
+            f[i * n + i] = T::one();
+            f[i * n + dims + i] = dt;
+            f[(dims + i) * n + dims + i] = T::one();
+            p0[i * n + i] = T::one();
+            p0[(dims + i) * n + dims + i] = T::one();
+            q_matrix[i * n + i] = q_position;
+            q_matrix[i * n + dims + i] = q_cross;
+            q_matrix[(dims + i) * n + i] = q_cross;
+            q_matrix[(dims + i) * n + dims + i] = q_velocity;
+            h[i * n + i] = T::one();
+        }
+
+        LinearKalmanFilterBuilder::new(n, dims)
+            .state_transition_matrix(f)
+            .observation_matrix(h)
+            .initial_covariance(Covariance::Full(p0))
+            .process_noise(Covariance::Full(q_matrix))
+            .measurement_noise(Covariance::Scalar(r))
+            .build()
+    }
+}
