@@ -0,0 +1,301 @@
+//! Tests for the post-update observer hook: the reported innovation `y`, its
+//! covariance `S` and `NIS = yᵀ S⁻¹ y`, its inertness when no observer is
+//! registered, and the statistical check that the mean NIS matches `m`.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use kalman_filters::KalmanError;
+use kalman_filters::linear::LinearKalmanFilter;
+
+// ---------------------------------------------------------------------------
+// Allocation counter (thread-local, transparent wrapper otherwise). Same
+// scheme as tests/spec_linear_kf.rs: only this test binary is instrumented.
+// ---------------------------------------------------------------------------
+mod alloc_counter {
+    use std::alloc::{GlobalAlloc, Layout, System};
+    use std::cell::Cell;
+
+    pub struct Counting;
+
+    thread_local! {
+        static COUNT: Cell<usize> = const { Cell::new(0) };
+    }
+
+    unsafe impl GlobalAlloc for Counting {
+        unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+            let _ = COUNT.try_with(|c| c.set(c.get() + 1));
+            unsafe { System.alloc(layout) }
+        }
+        unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+            unsafe { System.dealloc(ptr, layout) }
+        }
+        unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+            let _ = COUNT.try_with(|c| c.set(c.get() + 1));
+            unsafe { System.alloc_zeroed(layout) }
+        }
+        unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+            let _ = COUNT.try_with(|c| c.set(c.get() + 1));
+            unsafe { System.realloc(ptr, layout, new_size) }
+        }
+    }
+
+    pub fn count() -> usize {
+        COUNT.with(|c| c.get())
+    }
+}
+
+#[global_allocator]
+static GLOBAL: alloc_counter::Counting = alloc_counter::Counting;
+
+fn allocations_of(f: impl FnOnce()) -> usize {
+    let before = alloc_counter::count();
+    f();
+    alloc_counter::count() - before
+}
+
+// ---------------------------------------------------------------------------
+// Deterministic RNG: SplitMix64 plus Box–Muller standard normals.
+// ---------------------------------------------------------------------------
+struct Rng {
+    state: u64,
+    spare: Option<f64>,
+}
+
+impl Rng {
+    fn new(seed: u64) -> Self {
+        Self { state: seed, spare: None }
+    }
+
+    fn unit(&mut self) -> f64 {
+        self.state = self.state.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.state;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        ((z ^ (z >> 31)) >> 11) as f64 / (1u64 << 53) as f64
+    }
+
+    fn normal(&mut self) -> f64 {
+        if let Some(spare) = self.spare.take() {
+            return spare;
+        }
+        let u1 = self.unit().max(f64::MIN_POSITIVE);
+        let u2 = self.unit();
+        let radius = (-2.0 * u1.ln()).sqrt();
+        let angle = std::f64::consts::TAU * u2;
+        self.spare = Some(radius * angle.sin());
+        radius * angle.cos()
+    }
+}
+
+/// n = 2, m = 2 with correlated Q and R; used where the values themselves do
+/// not matter, only that two filters see the same numbers.
+fn model() -> LinearKalmanFilter<f64> {
+    LinearKalmanFilter::try_new(
+        2,
+        2,
+        &[1.0, -2.0],
+        &[0.5, 0.1, 0.1, 0.2],
+        &[1.0, 0.5, 0.0, 1.0],
+        &[0.02, 0.01, 0.01, 0.05],
+        &[1.0, 0.0, 0.0, 1.0],
+        &[0.3, 0.1, 0.1, 0.4],
+    )
+    .unwrap()
+}
+
+type Captured<T> = (Vec<T>, Vec<T>, T);
+
+fn assert_close(actual: &[f64], expected: &[f64], tol: f64) {
+    assert_eq!(actual.len(), expected.len(), "{actual:?} vs {expected:?}");
+    for (a, e) in actual.iter().zip(expected) {
+        assert!((a - e).abs() <= tol, "{actual:?} vs {expected:?}");
+    }
+}
+
+/// `yᵀ S⁻¹ y` for a 2×2 S, derived independently of the filter's solve.
+fn nis_2x2(y: &[f64], s: &[f64]) -> f64 {
+    let det = s[0] * s[3] - s[1] * s[2];
+    let v = [(s[3] * y[0] - s[1] * y[1]) / det, (s[0] * y[1] - s[2] * y[0]) / det];
+    y[0] * v[0] + y[1] * v[1]
+}
+
+#[test]
+fn reports_innovation_covariance_and_nis_for_one_step() {
+    // One predict + one update of `model()`, against the textbook equations.
+    // After predict: x = [0, -2], P = [[0.67, 0.21], [0.21, 0.25]].
+    let mut kf = model();
+    let reports: Rc<RefCell<Vec<Captured<f64>>>> = Rc::new(RefCell::new(Vec::new()));
+    let sink = Rc::clone(&reports);
+    kf.set_observer(move |report| {
+        sink.borrow_mut().push((report.innovation().to_vec(), report.covariance().to_vec(), report.nis()));
+    });
+
+    kf.predict().unwrap();
+    kf.update(&[0.5, -1.5]).unwrap();
+
+    assert!(kf.has_observer());
+    let reports = reports.borrow();
+    assert_eq!(reports.len(), 1);
+    let (y, s, nis) = &reports[0];
+
+    // The report describes the prior estimate, not the posterior.
+    assert_close(y, &[0.5, 0.5], 1e-12);
+    assert_close(s, &[0.97, 0.31, 0.31, 0.65], 1e-12);
+    assert_eq!(s[1], s[2], "reported S must be exactly symmetric");
+
+    // NIS is yᵀ S⁻¹ y, not yᵀ y (which would be 0.5 here).
+    assert!((nis - 0.467_814_371_257_485).abs() <= 1e-12, "{nis}");
+    assert!((nis - nis_2x2(y, s)).abs() <= 1e-12, "{nis}");
+
+    // The posterior estimate is unaffected by reporting.
+    assert_close(kf.state(), &[0.342_814_371_257_485, -1.778_817_365_269_461], 1e-12);
+}
+
+#[test]
+fn reports_the_expected_values_in_f32() {
+    let mut kf = LinearKalmanFilter::<f32>::try_new(
+        2,
+        2,
+        &[1.0, -2.0],
+        &[0.5, 0.1, 0.1, 0.2],
+        &[1.0, 0.5, 0.0, 1.0],
+        &[0.02, 0.01, 0.01, 0.05],
+        &[1.0, 0.0, 0.0, 1.0],
+        &[0.3, 0.1, 0.1, 0.4],
+    )
+    .unwrap();
+    let report: Rc<RefCell<Option<Captured<f32>>>> = Rc::new(RefCell::new(None));
+    let sink = Rc::clone(&report);
+    kf.set_observer(move |r| *sink.borrow_mut() = Some((r.innovation().to_vec(), r.covariance().to_vec(), r.nis())));
+
+    kf.predict().unwrap();
+    kf.update(&[0.5, -1.5]).unwrap();
+
+    let (y, s, nis) = report.borrow().clone().unwrap();
+    assert_eq!(s[1], s[2], "reported S must be exactly symmetric");
+    for (a, e) in y.iter().zip([0.5f32, 0.5]) {
+        assert!((a - e).abs() <= 1e-6, "{y:?}");
+    }
+    assert!((nis - 0.467_814_4).abs() <= 1e-5, "{nis}");
+}
+
+#[test]
+fn observer_does_not_change_the_estimate() {
+    // Bit-for-bit identical trajectories with and without an observer.
+    let (mut plain, mut watched) = (model(), model());
+    watched.set_observer(|_report| {});
+
+    for k in 0..200 {
+        let z = [0.1 * k as f64, -0.05 * k as f64 + 1.0];
+        plain.predict().unwrap();
+        plain.update(&z).unwrap();
+        watched.predict().unwrap();
+        watched.update(&z).unwrap();
+        assert_eq!(plain.state(), watched.state(), "state diverged at step {k}");
+        assert_eq!(plain.covariance(), watched.covariance(), "covariance diverged at step {k}");
+    }
+}
+
+#[test]
+fn steady_state_updates_allocate_nothing_with_or_without_observer() {
