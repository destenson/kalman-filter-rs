+//! What a successful update saw: the innovation `y`, its covariance `S` and
+//! the normalized innovation squared `NIS = yᵀ S⁻¹ y`.
+//!
+//! Reporting is opt-in. `LinearKalmanFilter::set_observer` registers a
+//! callback; a filter with none does no reporting work, and `update` does
+//! nothing beyond testing the `Option`. The report is handed over after the
+//! step has been committed, so the observer never sees values from a rejected
+//! update and cannot perturb the numbers.
+//!
+//! ```
+//! use std::cell::Cell;
+//! use std::rc::Rc;
+//! use kalman_filters::linear::LinearKalmanFilter;
+//!
+//! # let mut kf = LinearKalmanFilter::<f64>::try_new(
+//! #     1, 1, &[0.0], &[1.0], &[1.0], &[0.001], &[1.0], &[0.1]).unwrap();
+//! // The filter owns the callback, so collected state must be owned: Rc<Cell>.
+//! let last_nis = Rc::new(Cell::new(None));
+//! let sink = Rc::clone(&last_nis);
+//! kf.set_observer(move |report| sink.set(Some(report.nis())));
+//! kf.predict()?;
+//! kf.update(&[1.0])?;
+//! assert!(last_nis.get().unwrap() >= 0.0);
+//! # Ok::<(), kalman_filters::KalmanError>(())
+//! ```
+
+/// One successful update: `y = z − H x` (the prior `x`), its covariance
+/// `S = H P Hᵀ + R`, and `NIS = yᵀ S⁻¹ y`.
+#[derive(Clone, Copy, Debug)]
+pub struct InnovationReport<'a, T> {
+    innovation: &'a [T],
+    covariance: &'a [T],
+    nis: T,
+}
+
+impl<'a, T> InnovationReport<'a, T> {
+    pub(crate) fn new(innovation: &'a [T], covariance: &'a [T], nis: T) -> Self {
+        Self { innovation, covariance, nis }
+    }
+
+    /// Innovation `y = z − H x`, length `m`.
+    pub fn innovation(&self) -> &'a [T] {
+        self.innovation
+    }
+
+    /// Innovation covariance `S = H P Hᵀ + R`, `m × m`, row-major and exactly
+    /// symmetric.
+    pub fn covariance(&self) -> &'a [T] {
+        self.covariance
+    }
+
+    /// Normalized innovation squared `yᵀ S⁻¹ y`. For a correctly specified
+    /// filter it has a χ² distribution with `m` degrees of freedom, so its
+    /// running average should stay near `measurement_dim()`.
+    pub fn nis(&self) -> T
+    where
+        T: Copy,
+    {
+        self.nis
+    }
+}
