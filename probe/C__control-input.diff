+#[test]
+fn construction_validates_the_control_matrix() {
+    // Wrong length: B must be n×k.
+    let err = LinearKalmanFilter::<f64>::new_with_control(2, 1, 1, &[0.0, 0.0], &P0, &F, &Q, &H, &R, &[1.0, 2.0, 3.0]).expect_err("3 entries is not 2×1");
+    assert!(matches!(err, KalmanError::DimensionMismatch { expected: (2, 1), actual: (3, 1) }), "{err:?}");
+
+    // Non-finite B.
+    let err = LinearKalmanFilter::<f64>::new_with_control(2, 1, 1, &[0.0, 0.0], &P0, &F, &Q, &H, &R, &[f64::NAN, 1.0]).expect_err("NaN in B");
+    assert!(matches!(err, KalmanError::NonFiniteInput), "{err:?}");
+
+    // k = 0 has no meaning, just like n = 0 and m = 0.
+    let err = LinearKalmanFilter::<f64>::new_with_control(2, 1, 0, &[0.0, 0.0], &P0, &F, &Q, &H, &R, &[]).expect_err("k = 0");
+    assert!(matches!(err, KalmanError::ZeroDimension), "{err:?}");
+
+    // Compile-time control dimension must agree with the run-time one.
+    let err = LinearKalmanFilter::<f64, U2, U1, U2>::new_with_control(2, 1, 1, &[0.0, 0.0], &P0, &F, &Q, &H, &R, &B).expect_err("K = U2 but k = 1");
+    assert!(matches!(err, KalmanError::DimensionMismatch { .. }), "{err:?}");
+}
