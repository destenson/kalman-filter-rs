+#[test]
+fn static_control_dimensions_match_dynamic() {
+    let mut dynamic = with_control();
+    let mut fixed = LinearKalmanFilter::<f64, U2, U1, U1>::new_with_control(2, 1, 1, &[0.0, 0.0], &P0, &F, &Q, &H, &R, &B).expect("valid static model");
+    for k in 0..20 {
+        let u = [0.01 * k as f64];
+        dynamic.predict_with_control(&u).expect("predict with control");
+        fixed.predict_with_control(&u).expect("predict with control");
+        assert_eq!(dynamic.state(), fixed.state(), "state after step {k}");
+        assert_eq!(dynamic.covariance(), fixed.covariance(), "covariance after step {k}");
+    }
+}
