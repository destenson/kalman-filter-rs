index 0000000..29a050e
--- /dev/null
+++ b/tests/control_input.rs
@@ -0,0 +1,259 @@
+//! Control input support: `predict_with_control(u)` does `x ← F x + B u`.
+//!
+//! The running model is a double integrator sampled at `dt = 1`: state `[position, velocity]`,
+//! `F = [[1, dt], [0, 1]]`, `B = [[dt²/2], [dt]]`. A constant acceleration `a` then produces the
+//! closed form `v(k) = a·k·dt` and `p(k) = ½·a·(k·dt)²`, with no measurement updates and `Q = 0`.
+
+use kalman_filters::KalmanError;
+use kalman_filters::linear::LinearKalmanFilter;
+use nalgebra::{U1, U2};
+
+const DT: f64 = 1.0;
+const ACCEL: f64 = 2.0;
+/// `F`, row-major: `[[1, dt], [0, 1]]`.
+const F: [f64; 4] = [1.0, DT, 0.0, 1.0];
+/// `B`, row-major 2×1: `[[dt²/2], [dt]]`.
+const B: [f64; 2] = [0.5 * DT * DT, DT];
+const P0: [f64; 4] = [1.0, 0.0, 0.0, 1.0];
+const Q: [f64; 4] = [0.0; 4];
+const H: [f64; 2] = [1.0, 0.0];
+const R: [f64; 1] = [1.0];
+
+fn without_control() -> LinearKalmanFilter<f64> {
+    LinearKalmanFilter::<f64>::new(2, 1, &[0.0, 0.0], &P0, &F, &Q, &H, &R).expect("valid model")
+}
+
+fn with_control() -> LinearKalmanFilter<f64> {
+    LinearKalmanFilter::<f64>::new_with_control(2, 1, 1, &[0.0, 0.0], &P0, &F, &Q, &H, &R, &B).expect("valid model with control")
+}
+
+fn assert_close(actual: f64, expected: f64, what: &str) {
+    assert!((actual - expected).abs() <= 1e-12 * expected.abs().max(1.0), "{what}: {actual} != {expected}");
+}
+
+#[test]
+fn constant_acceleration_matches_closed_form_after_ten_steps() {
+    let mut kf = with_control();
+    for _ in 0..10 {
+        kf.predict_with_control(&[ACCEL]).expect("predict with control");
+    }
+    let t = 10.0 * DT;
+    assert_close(kf.state()[0], 0.5 * ACCEL * t * t, "position after 10 steps");
+    assert_close(kf.state()[1], ACCEL * t, "velocity after 10 steps");
+
+    // Q = 0, so P is F¹⁰ P0 F¹⁰ᵀ = [[101, 10], [10, 1]] regardless of u.
+    let p = kf.covariance();
+    assert_close(p[0], 101.0, "P[0,0]");
+    assert_close(p[1], 10.0, "P[0,1]");
+    assert_close(p[2], 10.0, "P[1,0]");
+    assert_close(p[3], 1.0, "P[1,1]");
+}
+
+#[test]
+fn constant_acceleration_matches_closed_form_in_f32() {
+    let to32 = |v: &[f64]| v.iter().map(|&x| x as f32).collect::<Vec<f32>>();
+    let mut kf = LinearKalmanFilter::<f32>::new_with_control(2, 1, 1, &[0.0, 0.0], &to32(&P0), &to32(&F), &to32(&Q), &to32(&H), &to32(&R), &to32(&B)).expect("valid f32 model with control");
+    for _ in 0..10 {
+        kf.predict_with_control(&[ACCEL as f32]).expect("predict with control");
+    }
+    let t = 10.0 * DT;
+    assert!((kf.state()[0] as f64 - 0.5 * ACCEL * t * t).abs() < 1e-4);
+    assert!((kf.state()[1] as f64 - ACCEL * t).abs() < 1e-4);
+}
+
+#[test]
+fn a_filter_without_control_matrix_behaves_as_before() {
+    // The no-control constructor is untouched: predict() and a filtered run over 20 cycles of
+    // predict+update give the same numbers as the control-aware filter when it gets u = 0.
+    let mut plain = without_control();
+    let mut controlled = with_control();
+    assert_eq!(plain.control_dim(), 0);
+    assert_eq!(controlled.control_dim(), 1);
+    for k in 0..20 {
+        let z = [0.1 * k as f64];
+        plain.predict().expect("predict");
+        controlled.predict().expect("predict");
+        plain.update(&z).expect("update");
+        controlled.update(&z).expect("update");
+        assert_eq!(plain.state(), controlled.state(), "state after cycle {k}");
+        assert_eq!(plain.covariance(), controlled.covariance(), "covariance after cycle {k}");
+    }
+}
+
+#[test]
+fn zero_control_is_the_same_step_as_predict() {
+    // On a filter without B, an empty u is the only valid control input and equals predict().
+    let mut plain = without_control();
+    let mut plain_no_control = without_control();
+    plain.predict_with_control(&[]).expect("empty control input");
+    plain_no_control.predict().expect("predict");
+    assert_eq!(plain.state(), plain_no_control.state());
+    assert_eq!(plain.covariance(), plain_no_control.covariance());
+
+    // On a filter with B, u = 0 adds an exact zero vector, so the step is unchanged too.
+    let mut controlled = with_control();
+    let mut controlled_no_control = with_control();
+    controlled.predict_with_control(&[0.0]).expect("zero control input");
+    controlled_no_control.predict().expect("predict");
+    assert_eq!(controlled.state(), controlled_no_control.state());
+    assert_eq!(controlled.covariance(), controlled_no_control.covariance());
+}
