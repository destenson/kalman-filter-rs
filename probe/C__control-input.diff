+#[test]
+fn control_moves_the_state_and_leaves_the_covariance_alone() {
+    let mut driven = with_control();
+    let mut coasting = with_control();
+    for _ in 0..10 {
+        driven.predict_with_control(&[ACCEL]).expect("predict with control");
+        coasting.predict_with_control(&[0.0]).expect("predict with zero control");
+    }
+    assert_close(driven.state()[0], 0.5 * ACCEL * 10.0 * 10.0, "position with acceleration");
+    assert_eq!(coasting.state(), &[0.0, 0.0], "no control, no motion");
+    assert_eq!(driven.covariance(), coasting.covariance(), "control input must not touch P");
+}
