+#[test]
+fn wrong_control_length_is_rejected_atomically() {
+    let mut kf = with_control();
+    kf.predict_with_control(&[ACCEL]).expect("predict with control");
+    let (x, p) = (kf.state().to_vec(), kf.covariance().to_vec());
+
+    let err = kf.predict_with_control(&[1.0, 2.0]).expect_err("length 2 is not k = 1");
+    assert!(matches!(err, KalmanError::DimensionMismatch { expected: (1, 1), actual: (2, 1) }), "{err:?}");
+    assert_eq!(kf.state(), x.as_slice(), "rejected call must not change x");
+    assert_eq!(kf.covariance(), p.as_slice(), "rejected call must not change P");
+
+    // The filter is still usable.
+    kf.predict_with_control(&[ACCEL]).expect("predict after rejected call");
+    assert_close(kf.state()[1], 2.0 * ACCEL * DT, "velocity after two accelerated steps");
+}
