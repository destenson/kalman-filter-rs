+#[test]
+fn non_finite_result_is_rejected_atomically() {
+    // A control input large enough to overflow x = F x + B u must not be committed (B20).
+    let identity = [1.0, 0.0, 0.0, 1.0];
+    let b = [1.0, 0.0];
+    let mut kf = LinearKalmanFilter::<f64>::new_with_control(2, 1, 1, &[1e308, 0.0], &P0, &identity, &Q, &H, &R, &b).expect("valid model");
+    let err = kf.predict_with_control(&[1e308]).expect_err("1e308 + 1e308 overflows");
+    assert!(matches!(err, KalmanError::FilterDivergence(_)), "{err:?}");
+    assert_eq!(kf.state(), &[1e308, 0.0]);
