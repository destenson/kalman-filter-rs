+/// Scratch buffers for one backward smoother step on an n-dimensional state, so the
+/// step need not allocate. Holds no information between calls.
+#[derive(Debug, Clone)]
+pub(crate) struct SmoothWorkspace<T> {
+    chol: Vec<T>,  // n×n  Cholesky factor of the predicted covariance
+    gain: Vec<T>,  // n×n  smoother gain J = P_k Fᵀ P_{k+1|k}⁻¹
+    delta: Vec<T>, // n×n  P_{k+1|N} − P_{k+1|k}
+    mixed: Vec<T>, // n×n  J·delta
+    dx: Vec<T>,    // n    x_{k+1|N} − x_{k+1|k}
+}
+
+impl<T: KalmanScalar> SmoothWorkspace<T> {
+    pub(crate) fn new(n: usize) -> Self {
+        let zeros = |len| vec![T::zero(); len];
+        Self {
+            chol: zeros(n * n),
+            gain: zeros(n * n),
+            delta: zeros(n * n),
+            mixed: zeros(n * n),
+            dx: zeros(n),
+        }
+    }
+}
