+#[test]
+fn returns_one_estimate_per_measurement() {
+    let kf = baseline();
+    let z = baseline_measurements(5);
+    let out = kf.smooth(&as_refs(&z)).expect("smoothing a valid sequence");
+    assert_eq!(out.steps(), 5);
+    assert_eq!(out.state_dim(), 2);
+    for k in 0..5 {
+        assert_eq!(out.state(k).expect("state in range").len(), 2, "state {k}");
+        assert_eq!(out.covariance(k).expect("covariance in range").len(), 4, "covariance {k}");
+    }
+    assert!(out.state(5).is_none());
+    assert!(out.covariance(5).is_none());
+}
