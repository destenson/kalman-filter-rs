+#[test]
+fn smoothing_starts_from_the_filters_current_estimate() {
+    // Documented contract: the filter's current estimate is the prior for step 0, not
+    // the estimate it was constructed with.
+    let z = baseline_measurements(10);
+    let future: Vec<Vec<f64>> = (0..8).map(|k| vec![5.0 + 0.1 * k as f64]).collect();
+    let mut kf = baseline();
+    for zk in &z[..5] {
+        kf.predict().unwrap();
+        kf.update(zk).unwrap();
+    }
+    let (x, p) = (kf.state().to_vec(), kf.covariance().to_vec());
+    let out = kf.smooth(&as_refs(&future)).unwrap();
+    let (sx, sp) = textbook_rts(2, 1, &x, &p, &F, &Q, &H, &R, &future);
+    for k in 0..future.len() {
+        assert_close(out.state(k).unwrap(), &sx[k], 1e-9, &format!("smoothed x, step {k}"));
+        assert_close(out.covariance(k).unwrap(), &sp[k], 1e-9, &format!("smoothed P, step {k}"));
+    }
+}
