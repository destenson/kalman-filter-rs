+#[test]
+fn smoothing_uses_future_measurements_to_reduce_error() {
+    // A 1-D random walk against a known truth, with white process and measurement noise.
+    // Averaged over the sequence, the smoothed states must be closer to the truth.
+    let (q, r): (f64, f64) = (0.1, 1.0);
+    let steps = 100;
+    let mut rng = Rng(0x5EED_0002);
+    let mut truth = vec![0.0f64];
+    for k in 1..steps {
+        truth.push(truth[k - 1] + q.sqrt() * rng.normal());
+    }
+    let z: Vec<Vec<f64>> = truth.iter().map(|&x| vec![x + r.sqrt() * rng.normal()]).collect();
+
+    let kf = LinearKalmanFilter::<f64>::new(1, 1, &[0.0], &[1.0], &[1.0], &[q], &[1.0], &[r]).unwrap();
+    let out = kf.smooth(&as_refs(&z)).unwrap();
+
+    let mut forward = kf.clone();
+    let mut filtered_error = 0.0;
+    let mut smoothed_error = 0.0;
+    for k in 0..steps {
+        forward.predict().unwrap();
+        forward.update(&z[k]).unwrap();
+        filtered_error += (forward.state()[0] - truth[k]).abs();
+        smoothed_error += (out.state(k).unwrap()[0] - truth[k]).abs();
+    }
+    assert!(
+        smoothed_error < 0.95 * filtered_error,
+        "smoothed total error {smoothed_error} should be below filtered total error {filtered_error}"
+    );
+}
