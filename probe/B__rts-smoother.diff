+#[test]
+fn smoothing_leaves_the_filter_unchanged_and_usable() {
+    // Two identical filters; one is asked to smooth a future sequence in the middle of
+    // its run. They must remain identical, step for step.
+    let z = baseline_measurements(10);
+    let future: Vec<Vec<f64>> = (0..8).map(|k| vec![5.0 + 0.1 * k as f64]).collect();
+    let mut smoothed_run = baseline();
+    let mut plain_run = baseline();
+    for k in 0..5 {
+        smoothed_run.predict().unwrap();
+        smoothed_run.update(&z[k]).unwrap();
+        plain_run.predict().unwrap();
+        plain_run.update(&z[k]).unwrap();
+    }
+    smoothed_run.smooth(&as_refs(&future)).unwrap();
+    assert_eq!(smoothed_run.state(), plain_run.state());
+    assert_eq!(smoothed_run.covariance(), plain_run.covariance());
+    for k in 5..10 {
+        smoothed_run.predict().unwrap();
+        smoothed_run.update(&z[k]).unwrap();
+        plain_run.predict().unwrap();
+        plain_run.update(&z[k]).unwrap();
+        assert_eq!(smoothed_run.state(), plain_run.state(), "state diverged at step {k}");
+        assert_eq!(smoothed_run.covariance(), plain_run.covariance(), "covariance diverged at step {k}");
+    }
+}
