+
+#[test]
+fn rejects_wrong_length_and_non_finite_measurements_without_changing_the_filter() {
+    let kf = baseline();
+    let (x, p) = (kf.state().to_vec(), kf.covariance().to_vec());
+
+    let wrong: [&[f64]; 1] = [&[1.0, 2.0]];
+    assert!(matches!(kf.smooth(&wrong), Err(KalmanError::DimensionMismatch { .. })));
+    let empty: [&[f64]; 1] = [&[]];
+    assert!(matches!(kf.smooth(&empty), Err(KalmanError::DimensionMismatch { .. })));
+    let nan: [&[f64]; 1] = [&[f64::NAN]];
+    assert!(matches!(kf.smooth(&nan), Err(KalmanError::InvalidInput(_))));
+    let inf: [&[f64]; 1] = [&[f64::INFINITY]];
+    assert!(matches!(kf.smooth(&inf), Err(KalmanError::InvalidInput(_))));
+
+    assert_eq!(kf.state(), &x[..], "state changed by a failed smooth");
+    assert_eq!(kf.covariance(), &p[..], "covariance changed by a failed smooth");
+
+    // A bad step in the middle of the sequence is reported too, and still changes nothing.
+    let middle: [&[f64]; 3] = [&[0.0], &[f64::NAN], &[1.0]];
+    assert!(matches!(kf.smooth(&middle), Err(KalmanError::InvalidInput(_))));
+    assert_eq!(kf.state(), &x[..]);
+    assert_eq!(kf.covariance(), &p[..]);
+}
