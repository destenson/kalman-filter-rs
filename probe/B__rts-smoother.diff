+/// One backward Rauch–Tung–Striebel step.
+///
+/// Given the filtered estimate at step k, the predicted estimate at step k+1
+/// (x_{k+1|k}, P_{k+1|k}) and the smoothed estimate at step k+1, writes the smoothed
+/// estimate at step k into `out`:
+///
+///   J      = P_k|k Fᵀ P_{k+1|k}⁻¹                solved through P_{k+1|k}'s Cholesky
+///   x_k|N  = x_k|k + J (x_{k+1|N} − x_{k+1|k})
+///   P_k|N  = P_k|k + J (P_{k+1|N} − P_{k+1|k}) Jᵀ
+///
+/// Errors: `SingularMatrix` if P_{k+1|k} is singular relative to its own scale;
+/// `FilterDivergence` if the result is non-finite.
+pub(crate) fn smooth_step<T: KalmanScalar>(
+    model: &Model<T>,
+    filtered: &Estimate<T>,
+    predicted_next: &Estimate<T>,
+    smoothed_next: &Estimate<T>,
+    ws: &mut SmoothWorkspace<T>,
+    out: &mut Estimate<T>,
+) -> KalmanResult<()> {
+    let n = model.state_dim();
+
+    // J = P Fᵀ P₊⁻¹: form P Fᵀ, then solve P₊ x = b for every row b of P Fᵀ. Because P₊
+    // is symmetric, the rows of the solutions are the rows of (P Fᵀ) P₊⁻¹ = J.
+    matrix::mul_bt(filtered.p(), model.f(), &mut ws.gain, n, n, n);
+    matrix::cholesky(predicted_next.p(), &mut ws.chol, n, matrix::relative_tolerance(n))?;
+    for row in ws.gain.chunks_exact_mut(n) {
+        matrix::cholesky_solve(&ws.chol, n, row);
+    }
+
+    // x = x_k|k + J (x_{k+1|N} − x_{k+1|k})
+    for (d, (&s, &p)) in ws.dx.iter_mut().zip(smoothed_next.x().iter().zip(predicted_next.x())) {
+        *d = s - p;
+    }
+    matrix::mul_vec(&ws.gain, &ws.dx, &mut out.x, n, n);
+    for (xo, &fi) in out.x.iter_mut().zip(filtered.x()) {
+        *xo = *xo + fi;
+    }
+
+    // P = P_k|k + J (P_{k+1|N} − P_{k+1|k}) Jᵀ
+    for (d, (&s, &p)) in ws.delta.iter_mut().zip(smoothed_next.p().iter().zip(predicted_next.p())) {
+        *d = s - p;
+    }
+    matrix::mul(&ws.gain, &ws.delta, &mut ws.mixed, n, n, n);
+    matrix::mul_bt(&ws.mixed, &ws.gain, &mut out.p, n, n, n);
+    for (po, &fp) in out.p.iter_mut().zip(filtered.p()) {
+        *po = *po + fp;
+    }
+    matrix::symmetrize(&mut out.p, n);
+
+    require_finite(out, "smoothing produced a non-finite estimate")
+}
+
 fn require_finite<T: Float>(e: &Estimate<T>, what: &'static str) -> KalmanResult<()> {
     if e.x.iter().chain(&e.p).all(|v| v.is_finite()) { Ok(()) } else { Err(divergence(what)) }
 }
