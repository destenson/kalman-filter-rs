+#[test]
+fn last_step_is_the_filtered_estimate_and_earlier_steps_are_not() {
+    let z = constant_velocity_measurements(25);
+    let path = constant_velocity().smooth(&z).expect("smoothing succeeds");
+    let (filtered_states, filtered_covariances) = filtered_path(&constant_velocity(), &z);
+
+    let last = path.steps() - 1;
+    assert_eq!(path.state(last).unwrap(), &filtered_states[last * 2..]);
+    assert_eq!(path.covariance(last).unwrap(), &filtered_covariances[last * 4..]);
+    // Some earlier step must differ, or the backward pass would be a no-op.
+    assert!(path.state(0).unwrap() != &filtered_states[..2]);
+}
+
+#[test]
+fn one_measurement_returns_the_filtered_estimate_unchanged() {
+    let z = [1.25];
+    let path = scalar_random_walk().smooth(&z).expect("smoothing succeeds");
+    let mut kf = scalar_random_walk();
+    kf.update(&z).expect("filter updates");
+    assert_eq!(path.steps(), 1);
+    assert_eq!(path.state(0).unwrap(), kf.state());
+    assert_eq!(path.covariance(0).unwrap(), kf.covariance());
+}
+
+#[test]
+fn smooth_leaves_the_filter_unchanged_and_reports_its_shape() {
+    let mut kf = constant_velocity();
+    kf.predict().unwrap();
+    kf.update(&[0.2]).unwrap();
+    let before = (kf.state().to_vec(), kf.covariance().to_vec());
+
+    let z = constant_velocity_measurements(10);
+    let path: SmoothedPath<f64> = kf.smooth(&z).expect("smoothing succeeds");
+    assert_eq!((kf.state().to_vec(), kf.covariance().to_vec()), before);
+
+    assert_eq!(path.state_dim(), 2);
+    assert_eq!(path.steps(), 10);
+    assert_eq!(path.states().len(), 10 * 2);
+    assert_eq!(path.covariances().len(), 10 * 4);
+    assert_eq!(path.state(10), None);
+    assert_eq!(path.covariance(10), None);
+}
+
+#[test]
+fn empty_interval_is_an_empty_path() {
+    let path = scalar_random_walk().smooth(&[]).expect("empty interval is not an error");
+    assert_eq!(path.steps(), 0);
+    assert_eq!(path.state_dim(), 1);
+    assert!(path.states().is_empty());
+    assert!(path.covariances().is_empty());
+    assert_eq!(path.state(0), None);
+    assert_eq!(path.covariance(0), None);
+}
