+#[test]
+fn smoothed_path_is_consistent_with_the_reference_in_f32() {
+    // f32 support: the smoothed path must reproduce the f64 textbook result to
+    // single-precision accuracy, with every step finite.
+    let (x0, p0, q, r) = (0.0, 1.0, 0.05, 0.5);
+    let z64 = scalar_measurements(40);
+    let z32: Vec<f32> = z64.iter().map(|&v| v as f32).collect();
+    let kf32 = LinearKalmanFilter::<f32>::new(
+        1,
+        1,
+        &[x0 as f32],
+        &[p0 as f32],
+        &[1.0],
+        &[q as f32],
+        &[1.0],
+        &[r as f32],
+    )
+    .expect("valid f32 model");
+    let path32 = kf32.smooth(&z32).expect("smoothing succeeds in f32");
+    let reference = scalar_reference(&z64, x0, p0, q, r);
+
+    for k in 0..z64.len() {
+        let state = path32.state(k).unwrap()[0] as f64;
+        let covariance = path32.covariance(k).unwrap()[0] as f64;
+        assert!((state - reference.smoothed_state[k]).abs() <= 1e-3, "state at {k}");
+        assert!((covariance - reference.smoothed_covariance[k]).abs() <= 1e-5, "covariance at {k}");
+    }
+}
