+//! Control input `x ← F x + B u` for the linear Kalman filter.
+//!
+//! These tests cover the optional control matrix `B`. The frozen acceptance
+//! tests in `spec_linear_kf.rs` build models without `B` and are untouched by
+//! this feature.
+
+use kalman_filters::KalmanError;
+use kalman_filters::linear::{Covariance, LinearKalmanFilter};
+
+const F_CV: [f64; 4] = [1.0, 1.0, 0.0, 1.0]; // [[1, dt], [0, 1]] at dt = 1
+const H_POS: [f64; 2] = [1.0, 0.0];
+const B_ACCEL: [f64; 2] = [0.5, 1.0]; // [dt²/2, dt] at dt = 1
+const P0: [f64; 4] = [1.0, 0.0, 0.0, 1.0];
+const Q_ZERO: [f64; 4] = [0.0; 4];
+
+fn acceleration_filter(dt: f64, b: &[f64]) -> LinearKalmanFilter<f64> {
+    LinearKalmanFilter::try_new_with_control(
+        2,
+        1,
+        1,
+        &[0.0, 0.0],
+        &P0,
+        &[1.0, dt, 0.0, 1.0],
+        &Q_ZERO,
+        &H_POS,
+        &[1.0],
+        b,
+    )
+    .expect("valid constant-acceleration model")
+}
+
+fn plain_filter() -> LinearKalmanFilter<f64> {
+    LinearKalmanFilter::try_new(2, 1, &[1.0, 2.0], &P0, &F_CV, &[0.01, 0.0, 0.0, 0.02], &H_POS, &[0.3]).unwrap()
+}
+
+// ---------------------------------------------------------------------------
+// The requested analytic check: constant acceleration, no measurements, Q = 0.
+// With x0 = 0 the exact solution after N steps of `x ← F x + B a` is
+// position = a·dt²·N²/2 and velocity = a·dt·N.
+// ---------------------------------------------------------------------------
+
+#[test]
+fn constant_acceleration_matches_the_analytic_state_after_ten_steps() {
+    let a = 3.0;
+    let mut kf = acceleration_filter(1.0, &B_ACCEL);
+    for _ in 0..10 {
+        kf.predict_with_control(&[a]).unwrap();
+    }
+    // dt = 1, N = 10: position = a·N²/2 = 150, velocity = a·N = 30.
+    // Every intermediate value is a small multiple of 1.5, so f64 is exact.
+    assert_eq!(kf.state(), &[150.0, 30.0]);
+}
+
+#[test]
+fn constant_acceleration_matches_the_analytic_state_at_another_dt() {
+    let (dt, a) = (0.5, 4.0);
+    let b = [dt * dt / 2.0, dt];
+    let mut kf = acceleration_filter(dt, &b);
+    for _ in 0..10 {
+        kf.predict_with_control(&[a]).unwrap();
+    }
+    // position = a·dt²·N²/2 = 50, velocity = a·dt·N = 20.
+    assert_eq!(kf.state(), &[50.0, 20.0]);
+}
+
+// ---------------------------------------------------------------------------
+// Models without B behave exactly as before.
+// ---------------------------------------------------------------------------
+
+#[test]
+fn predict_without_control_is_bit_identical_to_predict() {
+    let (mut plain, mut empty_control) = (plain_filter(), plain_filter());
+    assert_eq!(plain.control_dim(), 0);
+    for _ in 0..10 {
+        plain.predict().unwrap();
+        empty_control.predict_with_control(&[]).unwrap();
+    }
+    assert_eq!(plain.state(), empty_control.state());
+    assert_eq!(plain.covariance(), empty_control.covariance());
+    assert_eq!(plain.state(), &[21.0, 2.0]);
+}
+
+#[test]
+fn a_model_without_control_rejects_a_control_input() {
+    let mut kf = plain_filter();
+    let before = (kf.state().to_vec(), kf.covariance().to_vec());
+    assert!(matches!(
+        kf.predict_with_control(&[1.0]),
+        Err(KalmanError::DimensionMismatch { expected: (0, 1), actual: (1, 1) })
+    ));
+    assert_eq!((kf.state().to_vec(), kf.covariance().to_vec()), before);
+}
+
+#[test]
+fn control_changes_the_state_but_not_the_covariance() {
+    let mut driven =
+        LinearKalmanFilter::try_new_with_control(2, 1, 1, &[0.0; 2], &P0, &F_CV, &Q_ZERO, &H_POS, &[1.0], &B_ACCEL)
+            .unwrap();
+    let mut plain = LinearKalmanFilter::try_new(2, 1, &[0.0; 2], &P0, &F_CV, &Q_ZERO, &H_POS, &[1.0]).unwrap();
+    for _ in 0..5 {
+        driven.predict_with_control(&[2.0]).unwrap();
+        plain.predict().unwrap();
+    }
+    assert_eq!(driven.covariance(), plain.covariance());
+    // a = 2, dt = 1, N = 5: [a·dt²·N²/2, a·dt·N] = [25, 10].
+    assert_eq!(driven.state(), &[25.0, 10.0]);
+    assert_ne!(driven.state(), plain.state());
+}
+
+// ---------------------------------------------------------------------------
+// B is n×k, row-major, and u has length k.
+// ---------------------------------------------------------------------------
+
+#[test]
+fn several_control_inputs_use_the_row_major_b_layout() {
+    // B = [[1, 1], [0, 2]], x0 = [2, −1], u = [0.5, 3]:
+    // F x0 = [1, −1], B u = [3.5, 6], so x = [4.5, 5].
+    let b = [1.0, 1.0, 0.0, 2.0];
+    let mut kf =
+        LinearKalmanFilter::try_new_with_control(2, 1, 2, &[2.0, -1.0], &P0, &F_CV, &Q_ZERO, &H_POS, &[1.0], &b)
+            .unwrap();
+    assert_eq!(kf.control_dim(), 2);
+    kf.predict_with_control(&[0.5, 3.0]).unwrap();
+    assert_eq!(kf.state(), &[4.5, 5.0]);
+}
+
+#[test]
+fn predict_on_a_control_model_does_not_silently_drop_the_control_term() {
+    let mut kf = acceleration_filter(1.0, &B_ACCEL);
+    let before = (kf.state().to_vec(), kf.covariance().to_vec());
+    assert!(matches!(
+        kf.predict(),
+        Err(KalmanError::DimensionMismatch { expected: (1, 1), actual: (0, 1) })
+    ));
+    assert_eq!((kf.state().to_vec(), kf.covariance().to_vec()), before);
+    // An explicit zero control is accepted and is exactly a plain predict.
+    let mut plain = LinearKalmanFilter::try_new(2, 1, &[0.0; 2], &P0, &F_CV, &Q_ZERO, &H_POS, &[1.0]).unwrap();
+    kf.predict_with_control(&[0.0]).unwrap();
+    plain.predict().unwrap();
+    assert_eq!(kf.state(), plain.state());
+}
+
+#[test]
+fn bad_control_inputs_are_errors_not_panics() {
+    let mut kf = acceleration_filter(1.0, &B_ACCEL);
+    let before = (kf.state().to_vec(), kf.covariance().to_vec());
+    assert!(matches!(kf.predict_with_control(&[]), Err(KalmanError::DimensionMismatch { .. })));
+    assert!(matches!(kf.predict_with_control(&[1.0, 2.0]), Err(KalmanError::DimensionMismatch { .. })));
+    assert!(matches!(kf.predict_with_control(&[f64::NAN]), Err(KalmanError::NonFiniteInput)));
+    assert!(matches!(kf.predict_with_control(&[f64::INFINITY]), Err(KalmanError::NonFiniteInput)));
+    assert_eq!((kf.state().to_vec(), kf.covariance().to_vec()), before);
+
+    let build = |b: &[f64], k: usize| {
+        LinearKalmanFilter::<f64>::try_new_with_control(2, 1, k, &[0.0; 2], &P0, &F_CV, &Q_ZERO, &H_POS, &[1.0], b)
+    };
+    assert!(build(&[], 0).is_ok());
+    assert!(build(&B_ACCEL, 1).is_ok());
+    assert!(matches!(build(&[1.0], 1), Err(KalmanError::DimensionMismatch { .. })), "B too short");
+    assert!(matches!(build(&B_ACCEL, 2), Err(KalmanError::DimensionMismatch { .. })), "B too long for k");
+    assert!(matches!(build(&[1.0, 2.0], 0), Err(KalmanError::DimensionMismatch { .. })), "B given with k = 0");
+    assert!(matches!(build(&[f64::NAN, 1.0], 1), Err(KalmanError::NonFiniteInput)), "NaN in B");
+    assert!(matches!(build(&[f64::INFINITY, 1.0], 1), Err(KalmanError::NonFiniteInput)), "∞ in B");
+}
+
+// ---------------------------------------------------------------------------
+// Builder path.
+// ---------------------------------------------------------------------------
+
+#[test]
+fn builder_control_matches_the_direct_constructor() {
+    let mut built = LinearKalmanFilter::<f64>::builder(2, 1, &F_CV, &H_POS)
+        .control(&B_ACCEL)
+        .p0(Covariance::Scalar(1.0))
+        .q(Covariance::Scalar(0.0))
+        .r(Covariance::Scalar(1.0))
+        .try_build()
+        .unwrap();
+    let mut direct = acceleration_filter(1.0, &B_ACCEL);
+    assert_eq!(built.control_dim(), 1);
+    for _ in 0..3 {
+        built.predict_with_control(&[1.5]).unwrap();
+        direct.predict_with_control(&[1.5]).unwrap();
+    }
+    assert_eq!(built.state(), direct.state());
+    assert_eq!(built.covariance(), direct.covariance());
+
+    // No `.control` call: the model has no control input, k = 0.
+    let none = LinearKalmanFilter::<f64>::builder(2, 1, &F_CV, &H_POS)
+        .p0(Covariance::Scalar(1.0))
+        .q(Covariance::Scalar(0.0))
+        .r(Covariance::Scalar(1.0))
+        .try_build()
+        .unwrap();
+    assert_eq!(none.control_dim(), 0);
+
+    // A control length that is not a multiple of n has no n×k shape.
+    let e = LinearKalmanFilter::<f64>::builder(2, 1, &F_CV, &H_POS)
+        .control(&[1.0])
+        .p0(Covariance::Scalar(1.0))
+        .q(Covariance::Scalar(0.0))
+        .r(Covariance::Scalar(1.0))
+        .try_build();
+    assert!(matches!(e, Err(KalmanError::DimensionMismatch { .. })), "{e:?}");
+}
