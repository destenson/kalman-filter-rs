+//! Builder for the linear Kalman filter.
+//!
+//! [`LinearKalmanFilter::new`] takes eight positional slices. This builder
+//! names every piece, defaults the initial state to zero and accepts `P0`, `Q`
+//! and `R` either as full matrices, as diagonals or as a single variance.
+//!
+//! It is not a second source of truth. `build` expands the three covariance
+//! forms and hands the matrices to [`LinearKalmanFilter::new`], which remains
+//! the only place that decides whether a model is valid (dimensions,
+//! finiteness, positive semi-definiteness). The one rule the builder applies
+//! itself is the dimension check, via `crate::filter::checked_model_dims`,
+//! because it has to know the sizes before it can allocate the default initial
+//! state.
+
+use crate::error::{KalmanError, KalmanResult};
+use crate::filter::{LinearKalmanFilter, checked_model_dims};
+use crate::types::KalmanScalar;
+use log::{error, trace};
+
+/// A covariance matrix (P0, Q or R) as the caller chooses to give it.
+///
+/// ```no_run
+/// # use kalman_filters::CovarianceInput;
+/// // All three describe the same 2×2 matrix [[4.0, 0.0], [0.0, 4.0]].
+/// let full = CovarianceInput::full(vec![4.0, 0.0, 0.0, 4.0]);
+/// let diagonal = CovarianceInput::diagonal(vec![4.0, 4.0]);
+/// let scalar = CovarianceInput::scalar(4.0);
+/// ```
+#[derive(Debug, Clone, PartialEq)]
+pub enum CovarianceInput<T> {
+    /// The full matrix, row-major, `n × n` for P0 and Q, `m × m` for R.
+    /// [`LinearKalmanFilter::new`] checks the length.
+    Full(Vec<T>),
+    /// The diagonal; every off-diagonal entry is zero. One entry per state
+    /// (P0, Q) or per measurement (R).
+    Diagonal(Vec<T>),
+    /// A single variance `v`, giving the matrix `v · I`.
+    ///
+    /// A negative value is rejected as not positive semi-definite, exactly as a
+    /// negative diagonal entry would be in either of the other forms.
+    Scalar(T),
+}
+
+impl<T> CovarianceInput<T> {
+    /// The full row-major matrix.
+    pub fn full(entries: Vec<T>) -> Self {
+        Self::Full(entries)
+    }
+
+    /// The variances on the diagonal, everything else zero.
+    pub fn diagonal(variances: Vec<T>) -> Self {
+        Self::Diagonal(variances)
+    }
+
+    /// The single variance `v` of `v · I`.
+    pub fn scalar(variance: T) -> Self {
+        Self::Scalar(variance)
+    }
+}
+
+/// A `Vec` means the full matrix, matching the other builders.
+impl<T> From<Vec<T>> for CovarianceInput<T> {
+    fn from(entries: Vec<T>) -> Self {
+        Self::Full(entries)
+    }
+}
+
+/// A bare number means a variance, i.e. that number times the identity.
+impl<T: KalmanScalar> From<T> for CovarianceInput<T> {
+    fn from(variance: T) -> Self {
+        Self::Scalar(variance)
+    }
+}
+
+/// Builder for [`LinearKalmanFilter`].
+///
+/// The caller supplies the model matrices F and H, one covariance for the
+/// process noise and one for the measurements, and the covariance P0 of the
+/// initial estimate. The initial state defaults to zero. No covariance has a
+/// default: guessing `Q` or `R` gives a filter that runs and is quietly wrong,
+/// so leaving one out is a [`KalmanError::BuilderIncomplete`] error instead.
+///
+/// # Example
+/// ```
+/// use kalman_filters::{CovarianceInput, LinearKalmanFilterBuilder};
+///
+/// // Constant velocity in one spatial dimension: state [position, velocity],
+/// // position measured directly. The initial state defaults to zero.
+/// let mut kf = LinearKalmanFilterBuilder::<f64>::new(2, 1)
+///     .transition(vec![1.0, 0.1, 0.0, 1.0])
+///     .observation(vec![1.0, 0.0])
+///     .initial_covariance(10.0) // 10·I
+///     .process_noise(CovarianceInput::diagonal(vec![0.01, 0.01]))
+///     .measurement_noise(vec![0.5])
+///     .build()
+///     .unwrap();
+///
+/// assert_eq!(kf.state(), &[0.0, 0.0][..]);
+/// kf.predict().unwrap();
+/// kf.update(&[1.0]).unwrap();
+/// assert!(kf.state()[0] > 0.0);
+/// ```
+pub struct LinearKalmanFilterBuilder<T: KalmanScalar> {
+    state_dim: usize,
+    measurement_dim: usize,
+    initial_state: Option<Vec<T>>,
+    initial_covariance: Option<CovarianceInput<T>>,
+    transition: Option<Vec<T>>,
+    process_noise: Option<CovarianceInput<T>>,
+    observation: Option<Vec<T>>,
+    measurement_noise: Option<CovarianceInput<T>>,
+}
+
+impl<T: KalmanScalar> LinearKalmanFilterBuilder<T> {
+    /// A builder for a model with `state_dim` states and `measurement_dim`
+    /// measurements.
+    pub fn new(state_dim: usize, measurement_dim: usize) -> Self {
+        trace!(
+            "Creating LinearKalmanFilterBuilder: state_dim={state_dim}, measurement_dim={measurement_dim}"
+        );
+        Self {
+            state_dim,
+            measurement_dim,
+            initial_state: None,
+            initial_covariance: None,
+            transition: None,
+            process_noise: None,
+            observation: None,
+            measurement_noise: None,
+        }
+    }
+
+    /// Set the initial state x0 (length n). Defaults to zero.
+    pub fn initial_state(mut self, state: Vec<T>) -> Self {
+        self.initial_state = Some(state);
+        self
+    }
+
+    /// Set the covariance P0 of the initial estimate (n×n).
+    pub fn initial_covariance(mut self, covariance: impl Into<CovarianceInput<T>>) -> Self {
+        self.initial_covariance = Some(covariance.into());
+        self
+    }
+
+    /// Set the state transition matrix F (n×n, row-major).
+    pub fn transition(mut self, matrix: Vec<T>) -> Self {
+        self.transition = Some(matrix);
+        self
+    }
+
+    /// Set the process noise covariance Q (n×n).
+    pub fn process_noise(mut self, noise: impl Into<CovarianceInput<T>>) -> Self {
+        self.process_noise = Some(noise.into());
+        self
+    }
+
+    /// Set the observation matrix H (m×n, row-major).
+    pub fn observation(mut self, matrix: Vec<T>) -> Self {
+        self.observation = Some(matrix);
+        self
+    }
+
+    /// Set the measurement noise covariance R (m×m).
+    pub fn measurement_noise(mut self, noise: impl Into<CovarianceInput<T>>) -> Self {
+        self.measurement_noise = Some(noise.into());
+        self
+    }
+
+    /// A builder pre-filled with the constant-velocity model in `dims` spatial
+    /// dimensions, for time step `dt`, process-noise intensity `q` and
+    /// measurement variance `r`.
+    ///
+    /// The state is the `dims` positions followed by the `dims` velocities;
+    /// positions are measured directly. The model, with `I` the
+    /// `dims × dims` identity, is
+    /// ```text
+    /// F = [I  dt·I]   H = [I 0]   Q = q·[dt³/3  dt²/2] ⊗ I   R = r·I
+    ///     [0   I  ]                [dt²/2   dt  ]
+    /// ```
+    /// and the initial state is zero with P0 the identity.
+    ///
+    /// Errors: `InvalidDimension` for `dims = 0` or `2·dims` overflowing.
+    /// Everything else is checked by [`Self::build`], and
+    /// [`LinearKalmanFilter::constant_velocity`] is this preset in one call.
+    pub fn constant_velocity(dims: usize, dt: T, q: T, r: T) -> KalmanResult<Self> {
+        let m = dims;
+        let n = dims.checked_mul(2).ok_or(KalmanError::InvalidDimension {
+            state_dim: dims,
+            measurement_dim: dims,
+        })?;
+        let (nn, mn, mm) = checked_model_dims(n, m)?;
+
+        let zeros = |len: usize| vec![T::zero(); len];
+        let (mut f, mut h, mut q_noise, mut r_noise) = (zeros(nn), zeros(mn), zeros(nn), zeros(mm));
+        for i in 0..dims {
+            // Position i moves with velocity i; velocity i is unchanged.
+            f[i * n + i] = T::one();
+            f[i * n + dims + i] = dt;
+            f[(dims + i) * n + dims + i] = T::one();
+            // Position i is measured directly.
+            h[i * n + i] = T::one();
+            r_noise[i * m + i] = r;
+        }
+        // Discrete white-noise acceleration: one 2×2 block per spatial axis,
+        // `q·[[dt³/3, dt²/2], [dt²/2, dt]]`, with the axes independent.
+        let dt2 = dt * dt;
+        let dt3 = dt2 * dt;
+        let (pos_var, pos_cov, vel_var) = (
+            q * dt3 / T::from_f64(3.0),
+            q * dt2 / T::from_f64(2.0),
+            q * dt,
+        );
+        for i in 0..dims {
+            q_noise[i * n + i] = pos_var;
+            q_noise[i * n + dims + i] = pos_cov;
+            q_noise[(dims + i) * n + i] = pos_cov;
+            q_noise[(dims + i) * n + dims + i] = vel_var;
+        }
+
+        Ok(Self {
+            state_dim: n,
+            measurement_dim: m,
+            initial_state: None,
+            initial_covariance: Some(CovarianceInput::scalar(T::one())),
+            transition: Some(f),
+            process_noise: Some(CovarianceInput::Full(q_noise)),
+            observation: Some(h),
+            measurement_noise: Some(CovarianceInput::scalar(r)),
+        })
+    }
+
+    /// Build the filter.
+    ///
+    /// Errors: `InvalidDimension` first (nothing is allocated for a zero or
+    /// overflowing size), then [`KalmanError::BuilderIncomplete`] naming the
+    /// first missing piece in the order transition, observation,
+    /// initial_covariance, process_noise, measurement_noise, then whatever
+    /// [`LinearKalmanFilter::new`] reports for the gathered matrices.
+    pub fn build(self) -> KalmanResult<LinearKalmanFilter<T>> {
+        let (n, m) = (self.state_dim, self.measurement_dim);
+        trace!("Building Linear Kalman Filter: state_dim={n}, measurement_dim={m}");
+
+        // Sizes are needed before the default initial state can be allocated.
+        let (nn, _, mm) = checked_model_dims(n, m)?;
+
+        let transition = self.transition.ok_or_else(|| missing("transition"))?;
+        let observation = self.observation.ok_or_else(|| missing("observation"))?;
+        let initial_covariance = self
+            .initial_covariance
+            .ok_or_else(|| missing("initial_covariance"))?;
+        let process_noise = self.process_noise.ok_or_else(|| missing("process_noise"))?;
+        let measurement_noise = self
+            .measurement_noise
+            .ok_or_else(|| missing("measurement_noise"))?;
+
+        let initial_state = self.initial_state.unwrap_or_else(|| vec![T::zero(); n]);
+        let p0 = expand(initial_covariance, n, nn)?;
+        let q = expand(process_noise, n, nn)?;
+        let r = expand(measurement_noise, m, mm)?;
+
+        LinearKalmanFilter::new(n, m, &initial_state, &p0, &transition, &q, &observation, &r)
+    }
+}
+
+fn missing(field: &str) -> KalmanError {
+    error!("LinearKalmanFilterBuilder: missing {field}");
+    KalmanError::BuilderIncomplete(field.to_string())
+}
+
+/// A full matrix, a diagonal or a scalar as a dense row-major matrix of `dim`
+/// rows. `square` is `dim · dim`, already known not to overflow.
+fn expand<T: KalmanScalar>(
+    form: CovarianceInput<T>,
+    dim: usize,
+    square: usize,
+) -> KalmanResult<Vec<T>> {
+    let (mut matrix, diagonal) = match form {
+        // The length of a full matrix is checked by `new`, like every other
+        // caller-supplied slice.
+        CovarianceInput::Full(entries) => return Ok(entries),
+        CovarianceInput::Scalar(variance) => (vec![T::zero(); square], vec![variance; dim]),
+        CovarianceInput::Diagonal(variances) => {
+            if variances.len() != dim {
+                return Err(KalmanError::DimensionMismatch {
+                    expected: (dim, dim),
+                    actual: (variances.len(), variances.len()),
+                });
+            }
+            (vec![T::zero(); square], variances)
+        }
+    };
+    for (i, variance) in diagonal.into_iter().enumerate() {
+        matrix[i * dim + i] = variance;
+    }
+    Ok(matrix)
+}
