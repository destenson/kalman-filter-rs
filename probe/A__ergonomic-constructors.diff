+/// The one dimension rule for a model: neither dimension may be zero, and
+/// `n·n`, `m·n` and `m·m` must not overflow. Returns those three products.
+///
+/// `new` and the front ends in [`crate::builders`] call this, so a zero or
+/// overflowing size is rejected by one rule rather than one rule per
+/// constructor.
+pub(crate) fn checked_model_dims(n: usize, m: usize) -> KalmanResult<(usize, usize, usize)> {
+    let bad = KalmanError::InvalidDimension { state_dim: n, measurement_dim: m };
+    if n == 0 || m == 0 {
+        return Err(bad);
+    }
+    match (n.checked_mul(n), m.checked_mul(n), m.checked_mul(m)) {
+        (Some(nn), Some(mn), Some(mm)) => Ok((nn, mn, mm)),
+        _ => Err(bad),
+    }
+}
